<!DOCTYPE html>
<html lang="hi">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>
    <%= typeof title !== 'undefined' ? title : 'Nishad Sankalp Campaign' %> - Unity, Education & Empowerment
  </title>
  <meta name="description" content="<%= metaDescription %>" />
  <link rel="canonical" href="https://nishadaarakshansankalp.com/" />
  <meta property="og:title" content="Nishad Aarakshan Sankalp Campaign | Unity, Education &amp; Empowerment" />
  <meta property="og:description" content="<%= metaDescription %>" />
  <meta property="og:url" content="https://nishadaarakshansankalp.com/" />
  <meta property="og:type" content="website" />
  <meta property="og:image" content="https://nishadaarakshansankalp.com/images/logo.png" />
  <link rel="icon" type="image/png" href="/images/logo.png" />

  <!-- Google Fonts for authentic modern typography (Poppins + Noto Sans Devanagari) -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Devanagari:wght@400;500;600;700;800&family=Poppins:wght@400;500;600;700;800&display=swap"
    rel="stylesheet" />

  <!-- Core Global CSS -->
  <link rel="stylesheet" href="/css/index.css" />

  <!-- Arvind Kejriwal AAP Style Homepage CSS -->
  <link rel="stylesheet" href="/css/ak-homepage.css" />

  <!-- Supporting Components CSS -->
  <link rel="stylesheet" href="/css/sidebar.css" />
  <link rel="stylesheet" href="/css/initiative-modal.css" />
</head>

<body>
  <!-- Top Navigation Bar -->
  <%- include("common/navbar") %>

  <!-- Quick Action / Helpline Sidebar Drawer -->
  <%- include("components/sidebar") %>

  <!-- Dynamic Initiative Action Modal -->
  <%- include("components/initiative-modal") %>

  <!-- Main Content Area: Exact Sections as https://arvindkejriwalaap.com/ -->
  <main id="main-content">
    <!-- 1. Hero Section: Aspect-ratio Banner Slider with Left-Aligned Bold Titles -->
    <%- include("components/ak-hero") %>

    <!-- 2. About / Leader Section: Signature Xn Header, Vision Narrative, Read More CTA -->
    <%- include("components/ak-about") %>

    <!-- 3. Key Achievements Section: 4-Column Card Grid with Metric Badges & Stories -->
    <%- include("components/ak-achievements") %>

    <!-- 4. Journey Through Time Section: Milestones Timeline with Connecting Track & Nodes -->
    <%- include("components/ak-journey") %>

    <!-- 5. Gallery Section: Unified Photos & Videos Showcase Cards with View Gallery CTA -->
    <%- include("components/ak-gallery") %>

    <!-- 6. Events & News Section: Upcoming Events, Press Updates, Date Badges -->
    <%- include("components/ak-events") %>

    <!-- 7. Government Schemes Section: Community Welfare Initiatives with Apply/Support Modal -->
    <%- include("components/ak-schemes") %>

    <!-- 8. Social Wall & Connect Section: WhatsApp Live Connect, YouTube, Twitter & Helpline -->
    <%- include("components/ak-social") %>
  </main>

  <!-- Footer -->
  <%- include("common/footer") %>

  <!-- Modular Component JavaScript -->
  <script src="/js/ak-hero.js"></script>
  <script src="/js/sidebar.js"></script>
  <script src="/js/initiative-modal.js"></script>
  <script src="/js/index.js"></script>
</body>

</html>
