<!DOCTYPE html>
<html lang="hi">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>
    <%= typeof title !== 'undefined' ? title : 'पल्लवी पाल (Pallavi Pal)' %> - जनसेवा, विकास एवं सामाजिक न्याय
  </title>
  <meta name="description" content="<%= metaDescription %>" />
  <link rel="canonical" href="https://pallavipal.com/" />
  <meta property="og:title" content="पल्लवी पाल | आधिकारिक वेबसाइट - जनसेवा, विकास एवं सामाजिक न्याय" />
  <meta property="og:description" content="<%= metaDescription %>" />
  <meta property="og:url" content="https://pallavipal.com/" />
  <meta property="og:type" content="website" />
  <meta property="og:image" content="https://pallavipal.com/images/logo.png" />
  <link rel="icon" type="image/png" href="/images/logo.png" />

  <!-- Google Fonts for authentic modern typography (Poppins + Noto Sans Devanagari) -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Devanagari:wght@400;500;600;700;800&family=Poppins:wght@400;500;600;700;800&display=swap"
    rel="stylesheet" />

  <!-- Core Global CSS -->
  <link rel="stylesheet" href="/css/index.css" />
  <link rel="stylesheet" href="/css/common/navbar.css" />

  <!-- Arvind Kejriwal AAP Style Homepage CSS -->
  <link rel="stylesheet" href="/css/ak-homepage.css" />

  <!-- Social Wall Multi-Platform Rails CSS -->
  <link rel="stylesheet" href="/css/social.css" />

  <!-- Supporting Components CSS -->
  <link rel="stylesheet" href="/css/sidebar.css" />
  <link rel="stylesheet" href="/css/initiative-modal.css" />

  <!-- Scroll-Reveal & Interactive Animations CSS -->
  <link rel="stylesheet" href="/css/animations.css" />
</head>

<body>
  <!-- Top Navigation Bar -->
  <%- include("common/navbar") %>

  <!-- Quick Action / Helpline Sidebar Drawer -->
  <%- include("components/sidebar") %>

  <!-- Dynamic Initiative Action Modal -->
  <%- include("components/initiative-modal") %>

  <!-- Main Content Area -->
  <main id="main-content">
    <!-- 1. Hero Section: Aspect-ratio Banner Slider with Left-Aligned Bold Titles -->
    <%- include("components/ak-hero") %>

    <!-- 2. About / Leader Section: Signature Header, Vision Narrative, Read More CTA -->
    <%- include("components/ak-about") %>

    <!-- 3. Key Achievements Section: 4-Column Text-Only Card Grid (No Images) -->
    <%- include("components/ak-achievements") %>

    <!-- 4. Gallery Section: Unified Photos Showcase Cards with View Gallery CTA -->
    <%- include("components/ak-gallery") %>

    <!-- 5. Social Wall & Connect Section: Multi-Platform Rails (Instagram, Facebook, Twitter) -->
    <%- include("components/ak-social") %>
  </main>

  <!-- Footer -->
  <%- include("common/footer") %>

  <!-- Modular Component JavaScript -->
  <script src="/js/ak-hero.js"></script>
  <script src="/js/sidebar.js"></script>
  <script src="/js/initiative-modal.js"></script>
  <script src="/js/social.js"></script>
  <script src="/js/animations.js"></script>
  <script src="/js/index.js"></script>
</body>

</html>
