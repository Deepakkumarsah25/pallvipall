<!DOCTYPE html>
<html lang="hi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= typeof title !== 'undefined' ? title : 'फ़ोटो एवं कार्यक्रम गैलरी | पल्लवी पाल' %></title>
    <meta name="description" content="पल्लवी पाल - जनसंपर्क, विकास कार्यक्रम, महत्वपूर्ण बैठकें एवं सामाजिक आयोजनों की फ़ोटो एवं स्मृतियां।" />
    <link rel="canonical" href="https://pallavipal.com/gallery" />
    <meta property="og:title" content="फ़ोटो एवं कार्यक्रम गैलरी | पल्लवी पाल" />
    <meta property="og:description" content="पल्लवी पाल - जनसंपर्क, विकास कार्यक्रम और सामाजिक गतिविधियों की तस्वीरें।" />
    <meta property="og:url" content="https://pallavipal.com/gallery" />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="https://pallavipal.com/images/about/pallavi-pal-hero.jpg" />
    <link rel="icon" type="image/png" href="/images/logo.png" />

    <!-- Google Fonts for authentic typography -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Devanagari:wght@400;500;600;700;800&family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

    <!-- Global Site CSS -->
    <link rel="stylesheet" href="/css/index.css" />
    <link rel="stylesheet" href="/css/common/navbar.css" />
    <link rel="stylesheet" href="/css/sidebar.css" />

    <!-- Gallery Specific CSS -->
    <link rel="stylesheet" href="/css/gallery.css" />
  </head>
  <body class="gallery-page">
    <!-- Top Navigation Bar -->
    <%- include("common/navbar") %>

    <!-- Quick Action / Helpline Sidebar Drawer -->
    <%- include("components/sidebar") %>

    <!-- HERO BANNER (FADED TRANSLUCENT OVERLAY SO IMAGE IS CLEAR & MODERN) -->
    <section class="gallery-hero">
      <div class="gallery-hero-overlay"></div>
      <div class="gallery-hero-inner">
        <h1>
          <span>फ़ोटो एवं कार्यक्रम</span> गैलरी
        </h1>

        <p>
          विधानसभा क्षेत्र, सामाजिक सरोकार, जनसंवाद और प्रमुख आयोजनों की स्मृतियां एवं जीवंत झलकियां।
        </p>
      </div>
    </section>

    <!-- MAIN GALLERY CONTENT -->
    <main class="gallery-container">
      <!-- LIVE SEARCH & TOTAL COUNT CONTROLS BAR (SAME ROW ON MOBILE & DESKTOP) -->
      <section class="gallery-controls" aria-label="Photo search and count">
        <div class="gallery-controls-bar">
          <form id="galleryFilters" action="/gallery" method="get" class="gallery-search-form">
            <div class="gallery-search-input-box">
              <svg class="search-icon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
              </svg>
              <input
                type="text"
                name="search"
                id="gallerySearchInput"
                placeholder="Search..."
                value="<%= search || '' %>"
                aria-label="Search photos"
                autocomplete="off"
              />
              <% if (search) { %>
                <a href="/gallery" class="search-clear-btn" id="searchClearBtn" title="Clear search">✕</a>
              <% } %>
            </div>
          </form>

          <!-- RIGHT SIDE: TOTAL POST COUNT BADGE -->
          <div class="gallery-total-badge" id="galleryTotalBadge">
            <span class="total-badge-label">Total:</span>
            <strong class="total-badge-count"><%= (typeof totalPhotos !== 'undefined' ? totalPhotos : (pagination && pagination.total ? pagination.total : photos.length)) %></strong>
          </div>
        </div>
      </section>

      <!-- PHOTOS GRID (9 IMAGES PER PAGE, MODERN 3x3 GRID) -->
      <section class="gallery-grid" id="galleryGrid" aria-label="Event photos grid">
        <% if (photos && photos.length > 0) { %>
          <% photos.forEach(function(photo, index) { %>
            <% 
              const photoDateStr = photo.formattedDate || (photo.date ? new Date(photo.date).toLocaleDateString('hi-IN', { day: 'numeric', month: 'short', year: 'numeric' }) : '');
              const photoLocation = photo.district || photo.state || 'उत्तर प्रदेश';
              const photoTitle = photo.name || 'कार्यक्रम झलक';
              const photoDesc = photo.caption || 'पल्लवी पाल जी के नेतृत्व में जनसेवा व विकास कार्यक्रम की विशेष झलक।';
            %>
            <article
              class="gallery-card"
              data-district="<%= photoLocation %>"
              data-name="<%= photoTitle %>"
              data-date="<%= photoDateStr %>"
              data-caption="<%= photoDesc %>"
              data-image="<%= photo.imageUrl %>"
              tabindex="0"
              role="button"
              aria-label="<%= photoTitle %>, <%= photoLocation %>"
            >
              <!-- PHOTO CONTAINER WITH LOCATION ON LEFT & DATE ON RIGHT -->
              <div class="gallery-card-image-wrap">
                <img
                  src="<%= photo.imageUrl %>"
                  alt="<%= photoTitle %> — <%= photoLocation %>"
                  class="gallery-card-img"
                  loading="lazy"
                  onerror="this.src='/images/about/pallavi-pal-hero.jpg'"
                />
                <div class="gallery-card-overlay">
                  <!-- TOP META BAR: LOCATION LEFT, DATE RIGHT -->
                  <div class="card-meta-bar">
                    <span class="card-location-badge">
                      📍 <%= photoLocation %>
                    </span>
                    <% if (photoDateStr) { %>
                      <span class="card-date-badge">
                        📅 <%= photoDateStr %>
                      </span>
                    <% } %>
                  </div>

                  <div class="card-fullscreen-hint" title="फुल स्क्रीन में देखें">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2">
                      <path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"/>
                    </svg>
                  </div>
                </div>
              </div>

              <!-- CARD BODY: TITLE & DESCRIPTION -->
              <div class="gallery-card-body">
                <h3 class="gallery-card-title"><%= photoTitle %></h3>
                <p class="gallery-card-desc"><%= photoDesc %></p>
              </div>
            </article>
          <% }); %>
        <% } %>

        <!-- EMPTY STATE -->
        <div class="gallery-empty" id="galleryEmptyState" style="<%= (photos && photos.length > 0) ? 'display: none;' : 'display: block;' %>">
          <div class="gallery-empty-icon">🔍</div>
          <h3>No Photos Found</h3>
          <p>No photos matched your search. Try searching with different keywords.</p>
          <% if (search) { %>
            <a href="/gallery" class="btn-reset-search">View All Photos</a>
          <% } %>
        </div>
      </section>

      <!-- PAGINATION WITH PREVIOUS & NEXT BUTTONS (ALWAYS VISIBLE ABOVE FOOTER) -->
      <div id="galleryPaginationHost">
        <% 
          const currentTotalPages = (pagination && pagination.totalPages) ? pagination.totalPages : 1;
          const currentPage = (pagination && pagination.page) ? pagination.page : 1;
          const galleryPageUrl = (pageNumber) => {
            const params = new URLSearchParams();
            if (search) params.set('search', search);
            params.set('page', String(pageNumber));
            return '/gallery?' + params.toString();
          };
        %>
        <nav class="gallery-pagination" id="galleryPagination" aria-label="Gallery pages">
          <div class="gallery-pagination-controls">
            <!-- Previous Button -->
            <% if (currentPage > 1) { %>
              <a class="pagination-direction pagination-prev" href="<%= galleryPageUrl(currentPage - 1) %>">‹ Previous</a>
            <% } else { %>
              <span class="pagination-direction pagination-prev is-disabled">‹ Previous</span>
            <% } %>
            
            <!-- Numbered Pages -->
            <div class="pagination-pages">
              <% 
                let startPage = Math.max(1, currentPage - 2);
                let endPage = Math.min(Math.max(currentTotalPages, 1), startPage + 4);
                if (endPage - startPage < 4 && currentTotalPages > 4) {
                  startPage = Math.max(1, endPage - 4);
                }
                for (let p = startPage; p <= endPage; p++) { 
              %>
                <a class="pagination-number <%= p === currentPage ? 'is-current' : '' %>" href="<%= galleryPageUrl(p) %>" <%= p === currentPage ? 'aria-current="page"' : '' %>><%= p %></a>
              <% } %>
            </div>
            
            <!-- Next Button -->
            <% if (currentPage < currentTotalPages) { %>
              <a class="pagination-direction pagination-next" href="<%= galleryPageUrl(currentPage + 1) %>">Next ›</a>
            <% } else { %>
              <span class="pagination-direction pagination-next is-disabled">Next ›</span>
            <% } %>
          </div>
        </nav>
      </div>
    </main>

    <!-- FULLSCREEN LIGHTBOX / MODAL VIEWER -->
    <div class="gallery-lightbox" id="galleryLightbox" role="dialog" aria-modal="true" aria-label="Photo Lightbox">
      <!-- Lightbox Header Tools: Fullscreen Toggle & Close -->
      <div class="lightbox-top-tools">
        <button type="button" class="lightbox-tool-btn" id="lightboxFullscreenToggleBtn" title="फ़ुल स्क्रीन टॉगल करें">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.2">
            <path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"/>
          </svg>
        </button>
        <button type="button" class="lightbox-tool-btn" id="lightboxCloseBtn" title="बंद करें" aria-label="Close">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>

      <!-- Previous button -->
      <button type="button" class="lightbox-nav-btn lightbox-nav-prev" id="lightboxPrevBtn" aria-label="पिछली फ़ोटो" title="पिछली फ़ोटो">
        <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"/></svg>
      </button>

      <!-- Next button -->
      <button type="button" class="lightbox-nav-btn lightbox-nav-next" id="lightboxNextBtn" aria-label="अगली फ़ोटो" title="अगली फ़ोटो">
        <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
      </button>

      <!-- Fullscreen Content Container -->
      <div class="lightbox-stage" onclick="event.stopPropagation();">
        <div class="lightbox-image-viewport">
          <img id="lightboxImg" src="" alt="कार्यक्रम फ़ोटो" />
        </div>

        <div class="lightbox-info-bar">
          <div class="lightbox-info-left">
            <div class="lightbox-badges">
              <span class="lightbox-district-badge" id="lightboxDistrict">📍 Location</span>
              <span class="lightbox-date-badge" id="lightboxDate">📅 Date</span>
            </div>
            <h2 class="lightbox-name" id="lightboxName">कार्यक्रम शीर्षक</h2>
            <p class="lightbox-caption" id="lightboxCaption">
              कार्यक्रम या आयोजन का विवरण।
            </p>
          </div>

          <div class="lightbox-info-right">
            <a id="lightboxDownloadBtn" href="#" target="_blank" download class="lightbox-download-link">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
              <span>मूल फ़ोटो डाउनलोड</span>
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Footer -->
    <%- include("common/footer") %>

    <!-- Scripts -->
    <script src="/js/sidebar.js"></script>
    <script src="/js/gallery.js"></script>
  </body>
</html>
