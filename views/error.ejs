<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Devanagari:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <title><%= title %></title>
  <link rel="icon" type="image/png" href="/images/logo.png">

  <style>
    body {
      margin: 0;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: "Noto Sans Devanagari", sans-serif;
      background: #f6f9f7;
      color: #111d16;
    }

    .error-box {
      text-align: center;
      padding: 40px;
      background: #ffffff;
      border-radius: 16px;
      border: 1px solid #dce8e0;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.06);
      max-width: 480px;
      width: 90%;
    }

    h1 {
      font-size: 80px;
      margin: 0;
      color: #d71920;
    }

    h2 {
      margin: 10px 0;
      color: #111d16;
    }

    p {
      color: #5a7263;
    }

    a {
      display: inline-block;
      margin-top: 20px;
      padding: 12px 28px;
      background: linear-gradient(135deg, #d71920 0%, #b2141a 100%);
      color: white;
      text-decoration: none;
      border-radius: 8px;
      font-weight: 600;
      transition: all 0.25s ease;
    }

    a:hover {
      background: linear-gradient(135deg, #0b8441 0%, #065f2c 100%);
      box-shadow: 0 6px 16px rgba(11, 132, 65, 0.3);
      transform: translateY(-2px);
    }
  </style>
</head>

<body>

  <div class="error-box">

    <h1>404</h1>

    <h2>Page Not Found</h2>

    <p><%= message %></p>

    <a href="/">Go Home</a>

  </div>

</body>
</html>
