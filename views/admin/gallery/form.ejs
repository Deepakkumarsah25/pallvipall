<%- include("../common/header") %>
<%- include("../common/sidebar") %>

<div class="admin-main">
  <!-- Topbar -->
  <header class="admin-topbar">
    <div class="topbar-left">
      <button type="button" class="mobile-menu-trigger" id="adminMobileMenuBtn" aria-label="Menu">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
      </button>
      <div class="page-heading">
        <h1>
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="var(--admin-primary)" stroke-width="2.2"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
          <%= isEdit ? 'Edit Sankalp Photo' : 'Add New Sankalp Photo' %>
        </h1>
        <p><%= isEdit ? 'Update details or image for the existing photo' : 'Enter participant name, district, date, caption, and upload photo' %></p>
      </div>
    </div>
    <div class="topbar-right">
      <a href="/admin/gallery" class="btn-admin btn-admin-outline">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
        <span>Back to List</span>
      </a>
      <% if (!isEdit) { %>
        <a href="/admin/gallery/bulk" class="btn-admin btn-admin-outline" style="border-color: #c28834; color: #a26b1a; background: #fffdf9;">
          <span>Bulk Upload ↗</span>
        </a>
      <% } %>
    </div>
  </header>

  <!-- Body -->
  <div class="admin-body">
    <% if (error) { %>
      <div class="admin-alert admin-alert-error">⚠ <%= error %></div>
    <% } %>

    <div class="admin-card" style="max-width: 860px; margin: 0 auto;">
      <div class="admin-card-header">
        <h3>
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
          Photo Details Form
        </h3>
        <span style="font-size: 11px; color: var(--admin-text-muted);">* Fields marked with asterisk are required</span>
      </div>

      <div class="admin-card-body">
        <form
          action="<%= isEdit ? '/admin/gallery/edit/' + photo._id : '/admin/gallery/new' %>"
          method="POST"
          enctype="multipart/form-data"
        >
          <!-- Row 1: Participant Name -->
          <div class="form-group" style="margin-bottom: 20px;">
            <label for="name">Participant Name (प्रतिभागी का नाम) *</label>
            <input
              type="text"
              id="name"
              name="name"
              class="form-control"
              placeholder="उदा. जनसंवाद कार्यक्रम / पल्लवी पाल"
              value="<%= photo && photo.name ? photo.name : '' %>"
              required
            />
            <span class="form-hint">Name of the participant or group in the photo</span>
          </div>

          <!-- Row 2: State and District Selection -->
          <div class="form-grid-2">
            <div class="form-group">
              <label for="state">State (राज्य) *</label>
              <select id="state" name="state" class="form-control" required style="font-weight: 600;">
                <option value="">-- Select State (राज्य चुनें) --</option>
                <% if (typeof statesList !== 'undefined' && statesList.length > 0) { %>
                  <% statesList.forEach(function(st) { %>
                    <option value="<%= st %>" <%= (photo && photo.state === st) ? 'selected' : '' %>><%= st %></option>
                  <% }); %>
                <% } %>
              </select>
              <span class="form-hint">Select Indian State / Union Territory</span>
            </div>

            <div class="form-group">
              <label for="district">District (ज़िला) *</label>
              <select id="district" name="district" class="form-control" required style="font-weight: 600;">
                <option value="">-- Select District (ज़िला चुनें) --</option>
              </select>
              <input
                type="text"
                id="customDistrict"
                name="customDistrict"
                class="form-control"
                placeholder="Type custom district / tehsil name here..."
                style="display: none; margin-top: 8px;"
              />
              <span class="form-hint">Select district for selected state, or choose 'Other' to type custom</span>
            </div>
          </div>

          <!-- Grid 2: Date and Order -->
          <div class="form-grid-2">
            <div class="form-group">
              <label for="date">Pledge Date *</label>
              <input
                type="date"
                id="date"
                name="date"
                class="form-control"
                value="<%= photo && photo.date ? formatDateForInput(photo.date) : '' %>"
              />
              <span class="form-hint">Date when the pledge was taken</span>
            </div>

            <div class="form-group">
              <label for="order">Display Order</label>
              <input
                type="number"
                id="order"
                name="order"
                class="form-control"
                placeholder="0"
                value="<%= photo && typeof photo.order !== 'undefined' ? photo.order : 0 %>"
              />
              <span class="form-hint">Lower numbers display first (0, 1, 2...)</span>
            </div>
          </div>

          <!-- Caption -->
          <div class="form-group">
            <label for="caption">Caption or Pledge Message</label>
            <textarea
              id="caption"
              name="caption"
              class="form-control"
              rows="3"
              placeholder="e.g. Sacred pledge taken for unity, self-respect, and community upliftment..."
            ><%= photo && photo.caption ? photo.caption : '' %></textarea>
            <span class="form-hint">Message displayed in the lightbox when photo is clicked</span>
          </div>

          <!-- Image Upload / Image URL Section -->
          <div style="background: #faf7f5; padding: 20px; border-radius: 12px; border: 1px dashed #dfcfc7; margin-bottom: 24px;">
            <label style="display: block; font-size: 13px; font-weight: 800; color: var(--admin-text-dark); margin-bottom: 12px;">
              Select Photo *
            </label>

            <!-- Current image preview if editing -->
            <% if (photo && photo.imageUrl) { %>
              <div style="display: flex; align-items: center; gap: 16px; margin-bottom: 16px; padding: 10px; background: #fff; border-radius: 8px; border: 1px solid var(--admin-border);">
                <img
                  src="<%= photo.imageUrl %>"
                  alt="Current Photo"
                  id="currentPreview"
                  style="width: 100px; height: 70px; object-fit: cover; border-radius: 6px; border: 1px solid var(--admin-border);"
                />
                <div>
                  <strong style="display: block; font-size: 13px; color: var(--admin-text-dark);">Current Photo</strong>
                  <span style="font-size: 11px; color: var(--admin-text-muted);">If you do not upload a new photo, this image will be retained.</span>
                </div>
              </div>
            <% } %>

            <div class="form-grid-2">
              <div class="form-group" style="margin-bottom: 0;">
                <label for="photoFile" style="font-weight: 600;">Option 1: Upload photo from computer / phone</label>
                <input
                  type="file"
                  id="photoFile"
                  name="photo"
                  accept="image/*"
                  class="form-control"
                  style="padding-top: 8px;"
                  onchange="previewUploadedImage(this)"
                />
                <span class="form-hint">Supported formats: JPG, PNG, WEBP (Max 15MB)</span>
              </div>

              <div class="form-group" style="margin-bottom: 0;">
                <label for="imageUrl" style="font-weight: 600;">Option 2: Direct online photo URL</label>
                <input
                  type="url"
                  id="imageUrl"
                  name="imageUrl"
                  class="form-control"
                  placeholder="https://example.com/photo.jpg"
                  value="<%= photo && photo.imageUrl && !photo.imageFilename ? photo.imageUrl : '' %>"
                  oninput="previewUrlImage(this.value)"
                />
                <span class="form-hint">Use if the image is hosted on an external URL</span>
              </div>
            </div>

            <!-- Dynamic Live Preview Box -->
            <div id="livePreviewContainer" style="display: none; margin-top: 16px; text-align: center; padding: 12px; background: #fff; border-radius: 8px; border: 1px solid var(--admin-border);">
              <span style="display: block; font-size: 11px; font-weight: 700; color: var(--admin-text-muted); margin-bottom: 8px;">New Photo Preview</span>
              <img id="livePreviewImg" src="" alt="Preview" style="max-height: 180px; max-width: 100%; border-radius: 6px; object-fit: contain; box-shadow: 0 4px 10px rgba(0,0,0,0.08);"/>
            </div>
          </div>

          <!-- Publish Status Toggle -->
          <div class="form-group" style="display: flex; align-items: center; gap: 12px; margin-bottom: 24px; padding: 12px 16px; background: #fff; border: 1px solid var(--admin-border); border-radius: 9px;">
            <input
              type="checkbox"
              id="isPublished"
              name="isPublished"
              style="width: 20px; height: 20px; accent-color: var(--admin-primary); cursor: pointer;"
              <%= photo && photo.isPublished ? 'checked' : '' %>
            />
            <label for="isPublished" style="margin-bottom: 0; cursor: pointer; font-size: 13px; font-weight: 700;">
              Publish live immediately on website
              <span style="display: block; font-size: 11px; font-weight: 400; color: var(--admin-text-muted);">
                If unchecked, photo will remain hidden in draft status.
              </span>
            </label>
          </div>

          <!-- Buttons -->
          <div style="display: flex; align-items: center; justify-content: flex-end; gap: 12px; border-top: 1px solid var(--admin-border-subtle); padding-top: 20px;">
            <a href="/admin/gallery" class="btn-admin btn-admin-outline">
              Cancel
            </a>
            <button type="submit" class="btn-admin btn-admin-primary">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
              <span><%= isEdit ? 'Save Changes' : 'Add to Photo Gallery' %></span>
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<script src="/js/admin/india-states-districts.js"></script>
<script>
  document.addEventListener("DOMContentLoaded", function () {
    if (typeof setupStateDistrictSelectors === "function") {
      setupStateDistrictSelectors({
        stateEl: "state",
        districtEl: "district",
        customDistrictEl: "customDistrict",
        selectedState: "<%= photo && photo.state ? photo.state : '' %>",
        selectedDistrict: "<%= photo && photo.district ? photo.district : '' %>"
      });
    }

    // Ensure custom district is transferred to district field if '__other__' selected
    const form = document.querySelector("form");
    if (form) {
      form.addEventListener("submit", function (e) {
        const distEl = document.getElementById("district");
        const customDistEl = document.getElementById("customDistrict");
        if (distEl && distEl.value === "__other__") {
          if (!customDistEl || !customDistEl.value.trim()) {
            e.preventDefault();
            alert("Please type the custom district name.");
            if (customDistEl) customDistEl.focus();
            return false;
          }
        }
      });
    }
  });

  function previewUploadedImage(input) {
    const previewContainer = document.getElementById("livePreviewContainer");
    const previewImg = document.getElementById("livePreviewImg");
    if (input.files && input.files[0]) {
      const reader = new FileReader();
      reader.onload = function(e) {
        previewImg.src = e.target.result;
        previewContainer.style.display = "block";
      };
      reader.readAsDataURL(input.files[0]);
    }
  }

  function previewUrlImage(url) {
    const previewContainer = document.getElementById("livePreviewContainer");
    const previewImg = document.getElementById("livePreviewImg");
    if (url && url.startsWith("http")) {
      previewImg.src = url;
      previewContainer.style.display = "block";
    }
  }
</script>

<%- include("../common/footer") %>
