<%- include("../common/header") %>
<%- include("../common/sidebar") %>

<div class="admin-main">
  <!-- Topbar -->
  <header class="admin-topbar">
    <div class="topbar-left">
      <button type="button" class="mobile-menu-trigger" id="adminMobileMenuBtn" aria-label="Menu">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
      </button>
      <div class="page-heading">
        <h1>
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="var(--admin-primary)" stroke-width="2.2"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
          <%= isEdit ? 'फ़ोटो विवरण संपादित करें (Edit Photo)' : 'नई फ़ोटो जोड़ें (Add New Photo)' %>
        </h1>
        <p><%= isEdit ? 'फ़ोटो शीर्षक, स्थान, तारीख या छवि अपडेट करें' : 'कार्यक्रम या स्मृति की फ़ोटो, स्थान, तारीख और विवरण दर्ज करें' %></p>
      </div>
    </div>
    <div class="topbar-right">
      <a href="/admin/gallery" class="btn-admin btn-admin-outline">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
        <span>Back to List</span>
      </a>
      <% if (!isEdit) { %>
        <a href="/admin/gallery/bulk" class="btn-admin btn-admin-outline" style="border-color: #0b8441; color: #0b8441; background: #f0fdf4;">
          <span>Bulk Upload ↗</span>
        </a>
      <% } %>
    </div>
  </header>

  <!-- Body -->
  <div class="admin-body">
    <% if (error) { %>
      <div class="admin-alert admin-alert-error">⚠ <%= error %></div>
    <% } %>

    <div class="admin-card" style="max-width: 820px; margin: 0 auto;">
      <div class="admin-card-header">
        <h3>
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
          फ़ोटो एवं कार्यक्रम फॉर्म
        </h3>
        <span style="font-size: 11px; color: var(--admin-text-muted);">* आवश्यक फ़ील्ड</span>
      </div>

      <div class="admin-card-body">
        <form
          action="<%= isEdit ? '/admin/gallery/edit/' + photo._id : '/admin/gallery/new' %>"
          method="POST"
          enctype="multipart/form-data"
        >
          <!-- 1. Title / Event Name -->
          <div class="form-group" style="margin-bottom: 20px;">
            <label for="name" style="font-weight: 700;">कार्यक्रम / फ़ोटो शीर्षक (Title) *</label>
            <input
              type="text"
              id="name"
              name="name"
              class="form-control"
              placeholder="उदा. सिराथू जनसंवाद कार्यक्रम / लखनऊ नागरिक अभिनंदन"
              value="<%= photo && photo.name ? photo.name : '' %>"
              required
            />
            <span class="form-hint">फ़ोटो या आयोजन का संक्षिप्त और स्पष्ट शीर्षक</span>
          </div>

          <!-- 2. Location & Date (2 columns) -->
          <div class="form-grid-2" style="margin-bottom: 20px;">
            <div class="form-group">
              <label for="district" style="font-weight: 700;">स्थान / क्षेत्र (Location) *</label>
              <input
                type="text"
                id="district"
                name="district"
                class="form-control"
                placeholder="उदा. सिराथू, कौशाम्बी / लखनऊ"
                value="<%= photo && photo.district ? photo.district : 'उत्तर प्रदेश' %>"
                required
              />
              <span class="form-hint">आयोजन स्थल, ज़िला या क्षेत्र का नाम</span>
            </div>

            <div class="form-group">
              <label for="date" style="font-weight: 700;">कार्यक्रम तारीख (Event Date)</label>
              <input
                type="date"
                id="date"
                name="date"
                class="form-control"
                value="<%= photo && photo.date ? formatDateForInput(photo.date) : '' %>"
              />
              <span class="form-hint">जिस दिन यह आयोजन या फ़ोटो लिया गया</span>
            </div>
          </div>

          <!-- 3. Description -->
          <div class="form-group" style="margin-bottom: 24px;">
            <label for="caption" style="font-weight: 700;">विवरण (Description)</label>
            <textarea
              id="caption"
              name="caption"
              class="form-control"
              rows="3"
              placeholder="उदा. क्षेत्र के विकास कार्यों, जनसमस्याओं के निवारण एवं जनसंवाद की विशेष झलक।"
            ><%= photo && photo.caption ? photo.caption : '' %></textarea>
            <span class="form-hint">फ़ोटो कार्ड पर और बड़ी फ़ोटो देखने पर दिखने वाला विवरण</span>
          </div>

          <!-- 4. Photo Selection / Upload Box -->
          <div style="background: #f8faf9; padding: 22px; border-radius: 12px; border: 1.5px dashed #cde3d6; margin-bottom: 24px;">
            <label style="display: block; font-size: 14px; font-weight: 800; color: var(--admin-text-dark); margin-bottom: 14px;">
              फ़ोटो चयन (Select Image) *
            </label>

            <!-- Current image preview if editing -->
            <% if (photo && photo.imageUrl) { %>
              <div style="display: flex; align-items: center; gap: 16px; margin-bottom: 18px; padding: 12px; background: #fff; border-radius: 10px; border: 1px solid var(--admin-border);">
                <img
                  src="<%= photo.imageUrl %>"
                  alt="Current Photo"
                  id="currentPreview"
                  style="width: 110px; height: 75px; object-fit: cover; border-radius: 8px; border: 1px solid var(--admin-border);"
                />
                <div>
                  <strong style="display: block; font-size: 13px; color: var(--admin-text-dark);">वर्तमान फ़ोटो (Current Photo)</strong>
                  <span style="font-size: 12px; color: var(--admin-text-muted);">यदि आप नई फ़ोटो अपलोड नहीं करते हैं, तो यही फ़ोटो बनी रहेगी।</span>
                </div>
              </div>
            <% } %>

            <div class="form-grid-2">
              <div class="form-group" style="margin-bottom: 0;">
                <label for="photoFile" style="font-weight: 600;">विकल्प 1: कंप्यूटर / मोबाइल से फ़ोटो अपलोड करें</label>
                <input
                  type="file"
                  id="photoFile"
                  name="photo"
                  accept="image/*"
                  class="form-control"
                  style="padding-top: 8px;"
                  onchange="previewUploadedImage(this)"
                />
                <span class="form-hint">Supported: JPG, PNG, WEBP (Max 15MB)</span>
              </div>

              <div class="form-group" style="margin-bottom: 0;">
                <label for="imageUrl" style="font-weight: 600;">विकल्प 2: ऑनलाइन फ़ोटो URL (Image URL)</label>
                <input
                  type="url"
                  id="imageUrl"
                  name="imageUrl"
                  class="form-control"
                  placeholder="https://images.unsplash.com/..."
                  value="<%= photo && photo.imageUrl && !photo.imagePublicId ? photo.imageUrl : '' %>"
                />
                <span class="form-hint">यदि फ़ोटो पहले से ऑनलाइन होस्ट की गई है</span>
              </div>
            </div>

            <!-- Dynamic new upload preview container -->
            <div id="newUploadPreviewWrap" style="display: none; margin-top: 14px; padding: 10px; background: #fff; border-radius: 8px; border: 1px solid #bbf7d0;">
              <span style="font-size: 12px; font-weight: 700; color: #15803d; display: block; margin-bottom: 6px;">✓ चयनित नई फ़ोटो:</span>
              <img id="newUploadPreview" src="" alt="New upload preview" style="max-height: 120px; border-radius: 6px; object-fit: cover;" />
            </div>
          </div>

          <!-- 5. Order & Published Status -->
          <div class="form-grid-2" style="margin-bottom: 28px;">
            <div class="form-group">
              <label for="order" style="font-weight: 700;">प्रदर्शन क्रम (Display Order)</label>
              <input
                type="number"
                id="order"
                name="order"
                class="form-control"
                placeholder="0"
                value="<%= photo && typeof photo.order !== 'undefined' ? photo.order : 0 %>"
              />
              <span class="form-hint">कम संख्या वाली फ़ोटो पहले दिखेंगी (0, 1, 2...)</span>
            </div>

            <div class="form-group" style="display: flex; flex-direction: column; justify-content: center;">
              <label style="font-weight: 700; margin-bottom: 10px;">वेबसाइट पर दिखाएं (Publish Status)</label>
              <label style="display: inline-flex; align-items: center; gap: 10px; cursor: pointer; font-size: 14px; font-weight: 600; color: var(--admin-text-dark);">
                <input
                  type="checkbox"
                  name="isPublished"
                  value="true"
                  style="width: 18px; height: 18px; accent-color: var(--admin-primary);"
                  <%= (!photo || photo.isPublished !== false) ? 'checked' : '' %>
                />
                <span>हाँ, इस फ़ोटो को लाइव गैलरी में दिखाएं (Visible on Site)</span>
              </label>
            </div>
          </div>

          <!-- Form Action Buttons -->
          <div style="display: flex; align-items: center; gap: 14px; padding-top: 20px; border-top: 1px solid var(--admin-border);">
            <button type="submit" class="btn-admin btn-admin-primary" style="padding: 10px 24px; font-size: 15px;">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
              <span><%= isEdit ? 'अपडेट सुरक्षित करें (Save Changes)' : 'फ़ोटो जोड़ें (Save Photo)' %></span>
            </button>
            <a href="/admin/gallery" class="btn-admin btn-admin-outline" style="padding: 10px 18px;">
              रद्द करें (Cancel)
            </a>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<script>
  function previewUploadedImage(input) {
    if (input.files && input.files[0]) {
      const reader = new FileReader();
      reader.onload = function(e) {
        const wrap = document.getElementById('newUploadPreviewWrap');
        const img = document.getElementById('newUploadPreview');
        if (wrap && img) {
          img.src = e.target.result;
          wrap.style.display = 'block';
        }
      };
      reader.readAsDataURL(input.files[0]);
    }
  }
</script>

<%- include("../common/footer") %>
