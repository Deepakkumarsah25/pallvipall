<%- include("../common/header") %>
<%- include("../common/sidebar") %>

<div class="admin-main">
  <!-- Topbar -->
  <header class="admin-topbar">
    <div class="topbar-left">
      <button type="button" class="mobile-menu-trigger" id="adminMobileMenuBtn" aria-label="Menu">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
      </button>
      <div class="page-heading">
        <h1>
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="var(--admin-primary)" stroke-width="2.2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
          एक साथ कई फ़ोटो अपलोड करें (Bulk Image Upload)
        </h1>
        <p>एक साथ कई फ़ोटो चुनें, उनका स्थान, तारीख और शीर्षक सेट करें और एक क्लिक में अपलोड करें</p>
      </div>
    </div>
    <div class="topbar-right">
      <a href="/admin/gallery" class="btn-admin btn-admin-outline">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
        <span>Back to Gallery</span>
      </a>
      <a href="/admin/gallery/new" class="btn-admin btn-admin-primary">
        <span>Add Single Photo</span>
      </a>
    </div>
  </header>

  <!-- Body -->
  <div class="admin-body">
    <% if (error) { %>
      <div class="admin-alert admin-alert-error">⚠ <%= error %></div>
    <% } %>

    <div class="admin-card" style="max-width: 860px; margin: 0 auto;">
      <div class="admin-card-header">
        <h3>
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>
          मल्टीपल इमेज बैच अपलोड कंसोल
        </h3>
        <span style="font-size: 11px; color: var(--admin-text-muted);">एक साथ 50 फ़ोटो तक समर्थित</span>
      </div>

      <div class="admin-card-body">
        <form
          action="/admin/gallery/bulk-upload"
          method="POST"
          enctype="multipart/form-data"
          id="bulkUploadForm"
        >
          <!-- Upload Dropzone -->
          <div
            id="dropArea"
            style="border: 2px dashed #0b8441; background: #f0fdf4; border-radius: 14px; padding: 36px 20px; text-align: center; cursor: pointer; transition: all 0.2s ease; margin-bottom: 24px;"
            onclick="document.getElementById('bulkPhotos').click();"
          >
            <div style="width: 58px; height: 58px; background: #dcfce7; color: var(--admin-primary); border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; margin-bottom: 12px;">
              <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
            </div>
            <div style="font-size: 16px; font-weight: 800; color: var(--admin-text-dark);">
              फ़ोटो यहां खींचें और छोड़ें या ब्राउज़ करने के लिए क्लिक करें
            </div>
            <p style="font-size: 12px; color: var(--admin-text-muted); margin-top: 6px;">
              एक साथ 1 से 50 फ़ोटो चुनें (JPG, PNG, WEBP)
            </p>
            <input
              type="file"
              id="bulkPhotos"
              name="photos"
              multiple
              accept="image/*"
              style="display: none;"
              onchange="handleBulkFilesSelected(this)"
              required
            />
          </div>

          <!-- Preview Grid for Selected Files -->
          <div id="fileSelectionInfo" style="display: none; margin-bottom: 24px;">
            <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px;">
              <strong id="fileCountBadge" style="font-size: 13px; color: var(--admin-primary); font-weight: 800;">
                0 फ़ोटो चयनित
              </strong>
              <button
                type="button"
                onclick="clearBulkSelection()"
                style="border: none; background: none; color: #b91c1c; font-size: 12px; font-weight: 700; cursor: pointer;"
              >
                ✕ Clear All
              </button>
            </div>
            <div
              id="thumbnailsGrid"
              style="display: grid; grid-template-columns: repeat(auto-fill, minmax(90px, 1fr)); gap: 10px; max-height: 220px; overflow-y: auto; padding: 12px; background: #fff; border: 1px solid var(--admin-border); border-radius: 10px;"
            ></div>
          </div>

          <!-- Batch Common Settings -->
          <div style="background: #f8faf9; padding: 22px; border-radius: 12px; border: 1px solid #dce8e0; margin-bottom: 24px;">
            <h4 style="font-size: 14px; font-weight: 800; color: var(--admin-text-dark); margin: 0 0 16px;">
              चयनित सभी फ़ोटो के लिए सामान्य विवरण (Common Event Details)
            </h4>

            <div class="form-grid-2" style="margin-bottom: 16px;">
              <div class="form-group" style="margin-bottom: 0;">
                <label for="location" style="font-weight: 700;">स्थान / क्षेत्र (Location) *</label>
                <input
                  type="text"
                  id="location"
                  name="location"
                  class="form-control"
                  placeholder="उदा. सिराथू, कौशाम्बी / लखनऊ"
                  value="उत्तर प्रदेश"
                  required
                />
                <span class="form-hint">सभी फ़ोटो पर यही स्थान दिखेगा</span>
              </div>

              <div class="form-group" style="margin-bottom: 0;">
                <label for="defaultDate" style="font-weight: 700;">कार्यक्रम तारीख (Event Date)</label>
                <input
                  type="date"
                  id="defaultDate"
                  name="defaultDate"
                  class="form-control"
                  value="<%= typeof todayStr !== 'undefined' ? todayStr : '' %>"
                />
                <span class="form-hint">आयोजन की तारीख</span>
              </div>
            </div>

            <div class="form-group" style="margin-bottom: 16px;">
              <label for="title" style="font-weight: 700;">शीर्षक / कार्यक्रम नाम (Title Prefix)</label>
              <input
                type="text"
                id="title"
                name="title"
                class="form-control"
                placeholder="उदा. सिराथू जनसंवाद कार्यक्रम"
                value="कार्यक्रम झलकियां"
              />
              <span class="form-hint">फ़ोटो पर नाम दिया जाएगा (उदा. शीर्षक #1, #2...)</span>
            </div>

            <div class="form-group" style="margin-bottom: 16px;">
              <label for="description" style="font-weight: 700;">विवरण (Description)</label>
              <textarea
                id="description"
                name="description"
                class="form-control"
                rows="2"
                placeholder="उदा. पल्लवी पाल जी के नेतृत्व में जनसेवा व विकास कार्यक्रम की विशेष झलक।"
              ></textarea>
              <span class="form-hint">सभी फ़ोटो के लिए सामान्य विवरण</span>
            </div>

            <div class="form-group" style="margin-bottom: 0;">
              <label style="display: inline-flex; align-items: center; gap: 8px; cursor: pointer; font-size: 14px; font-weight: 600; color: var(--admin-text-dark);">
                <input
                  type="checkbox"
                  name="isPublished"
                  value="true"
                  checked
                  style="width: 18px; height: 18px; accent-color: var(--admin-primary);"
                />
                <span>अपलोड के तुरंत बाद लाइव वेबसाइट पर प्रकाशित करें (Publish Live)</span>
              </label>
            </div>
          </div>

          <!-- Submit Button -->
          <div style="display: flex; align-items: center; gap: 14px;">
            <button
              type="submit"
              id="bulkSubmitBtn"
              class="btn-admin btn-admin-primary"
              style="padding: 12px 28px; font-size: 15px; font-weight: 700;"
            >
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
              <span>अपलोड शुरू करें (Upload All)</span>
            </button>
            <a href="/admin/gallery" class="btn-admin btn-admin-outline" style="padding: 12px 20px;">
              रद्द करें (Cancel)
            </a>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<script>
  function handleBulkFilesSelected(input) {
    const files = input.files;
    const fileSelectionInfo = document.getElementById("fileSelectionInfo");
    const fileCountBadge = document.getElementById("fileCountBadge");
    const thumbnailsGrid = document.getElementById("thumbnailsGrid");

    if (!files || files.length === 0) {
      fileSelectionInfo.style.display = "none";
      return;
    }

    fileCountBadge.textContent = `${files.length} फ़ोटो चयनित`;
    thumbnailsGrid.innerHTML = "";

    Array.from(files).forEach((file) => {
      const reader = new FileReader();
      reader.onload = (e) => {
        const div = document.createElement("div");
        div.style.cssText = "position: relative; width: 100%; height: 60px; border-radius: 6px; overflow: hidden; border: 1px solid var(--admin-border);";
        const img = document.createElement("img");
        img.src = e.target.result;
        img.style.cssText = "width: 100%; height: 100%; object-fit: cover;";
        div.appendChild(img);
        thumbnailsGrid.appendChild(div);
      };
      reader.readAsDataURL(file);
    });

    fileSelectionInfo.style.display = "block";
  }

  function clearBulkSelection() {
    const input = document.getElementById("bulkPhotos");
    if (input) input.value = "";
    document.getElementById("fileSelectionInfo").style.display = "none";
    document.getElementById("thumbnailsGrid").innerHTML = "";
  }
</script>

<%- include("../common/footer") %>
