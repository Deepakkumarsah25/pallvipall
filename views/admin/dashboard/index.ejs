              </a>
              <a href="/admin/gallery" style="font-size: 12px; font-weight: 700; color: var(--admin-primary); text-decoration: none; display: inline-flex; align-items: center; gap: 4px;">
                <span>Manage All</span>
                <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
              </a>
            </div>
          </div>

          <div style="padding: 18px;">
            <div class="dash-photos-grid">
              <% if (recentPhotos && recentPhotos.length > 0) { %>
                <% recentPhotos.forEach(function(photo) { %>
                  <div class="dash-photo-card">
                    <div class="dash-photo-thumb">
                      <img
                        src="<%= photo.imageUrl %>"
                        alt="<%= photo.name %>"
                        onerror="this.src='https://placehold.co/240x160/eadfd7/333?text=Photo'"
                      />
                      <span class="dash-photo-badge" title="<%= photo.district %>">
                        📍 <%= photo.district %>
                      </span>
                    </div>
                    <div style="padding: 12px; display: flex; flex-direction: column; justify-content: space-between; flex: 1;">
                      <div>
                        <strong style="display: block; font-size: 12px; color: var(--admin-text-dark); margin-bottom: 2px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title="<%= photo.name %>">
                          <%= photo.name %>
                        </strong>
                        <span style="display: block; font-size: 11px; color: var(--admin-text-muted);">
                          <%= photo.formattedDate || (photo.date ? new Date(photo.date).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }) : '-') %>
                        </span>
                      </div>
                      <div style="margin-top: 10px; display: flex; align-items: center; justify-content: space-between; border-top: 1px solid #f1eae5; padding-top: 8px;">
                        <span style="font-size: 10px; font-weight: 800; color: <%= photo.isPublished ? '#047857' : '#94a3b8' %>;">
                          <%= photo.isPublished ? '✓ Live' : '✕ Draft' %>
                        </span>
                        <a href="/admin/gallery/edit/<%= photo._id %>" style="font-size: 11px; font-weight: 700; color: var(--admin-primary); text-decoration: none;">
                          Edit ↗
                        </a>
                      </div>
                    </div>
                  </div>
                <% }); %>
              <% } else { %>
                <div style="grid-column: 1 / -1; text-align: center; padding: 30px; color: var(--admin-text-muted);">
                  No photos available yet. Click '+ Add Single Sankalp Photo' or 'Bulk Upload' to add gallery images.
                </div>
              <% } %>
            </div>
          </div>
        </div>

        <!-- C. Top Participating Districts (Analytics) -->
        <div class="admin-card">
          <div class="admin-card-header">
            <h3 style="display: flex; align-items: center; gap: 8px; margin: 0; font-size: 15px; font-weight: 800; color: var(--admin-text-dark);">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="var(--admin-primary)" stroke-width="2.2">
                <path d="M18 20V10"/>
                <path d="M12 20V4"/>
                <path d="M6 20v-6"/>
              </svg>
              Top Participating Districts (Analytics)
            </h3>
            <a href="/admin/gallery" style="font-size: 12px; font-weight: 700; color: var(--admin-primary); text-decoration: none;">
              Filter Gallery ↗
            </a>
          </div>

          <div style="padding: 18px;">
            <% if (topDistricts && topDistricts.length > 0) { %>
              <% 
                const totalPhotosCount = topDistricts.reduce((acc, curr) => acc + (curr.count || 0), 0);
                const maxDistrictCount = Math.max(...topDistricts.map(d => d.count || 1), 1);
              %>

              <div class="dash-analytics-list">
                <% topDistricts.forEach(function(d, idx) { %>
                  <% 
                    const relativePct = Math.min(100, Math.round((d.count / maxDistrictCount) * 100));
                    const sharePct = ((d.count / (totalPhotosCount || 1)) * 100).toFixed(1);
                    const rankClass = idx === 0 ? 'rank-top1' : (idx === 1 ? 'rank-top2' : (idx === 2 ? 'rank-top3' : 'rank-other'));
                    const barClass = idx === 0 ? 'bar-fill-top1' : (idx === 1 ? 'bar-fill-top2' : (idx === 2 ? 'bar-fill-top3' : 'bar-fill-other'));
                    const tagClass = idx === 0 ? 'tag-leader' : (idx < 3 ? 'tag-momentum' : 'tag-active');
                    const tagLabel = idx === 0 ? '🔥 Top Performer' : (idx < 3 ? '⚡ High Momentum' : '✓ Active Region');
                  %>
                  <div class="dash-analytics-row">
                    <!-- Rank Chip -->
                    <div class="dash-analytics-rank <%= rankClass %>" title="Rank #<%= idx + 1 %>">
                      #<%= (idx + 1 < 10 ? '0' : '') + (idx + 1) %>
                    </div>

                    <!-- District Meta -->
                    <div class="dash-analytics-meta">
                      <div class="dash-analytics-name" title="<%= d._id %>">
                        <span>📍</span>
                        <strong><%= d._id %></strong>
                      </div>
                      <span class="dash-analytics-tag <%= tagClass %>">
                        <%= tagLabel %>
                      </span>
                    </div>

                    <!-- Comparative Progress Bar -->
                    <div class="dash-analytics-bar-track">
                      <div class="dash-analytics-bar-fill <%= barClass %>" style="width: <%= relativePct %>%;"></div>
                    </div>

                    <!-- Metric Numbers & Share -->
                    <div class="dash-analytics-nums">
                      <span class="dash-analytics-badge-count" title="Recorded photo count">
                        <strong><%= d.count %></strong> photos
                      </span>
                      <span class="dash-analytics-badge-pct" title="Share of total campaign volume">
                        <%= sharePct %>%
                      </span>
                    </div>
                  </div>
                <% }); %>
              </div>
            <% } else { %>
              <p style="text-align: center; color: var(--admin-text-muted); font-size: 13px; padding: 20px;">
                District analytics is updating based on uploaded gallery photos...
              </p>
            <% } %>
          </div>
        </div>
      </div>

      <!-- RIGHT COLUMN (SIDEBAR) -->
      <div>
        <!-- 1. Quick Actions Panel -->
        <div class="admin-card" style="margin-bottom: 24px;">
          <div class="admin-card-header">
