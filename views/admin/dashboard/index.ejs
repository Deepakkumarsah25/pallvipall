        <!-- A. Recent Sankalp Gallery Photos -->
        <div class="admin-card" style="margin-bottom: 24px;">
          <div class="admin-card-header">
            <h3 style="display: flex; align-items: center; gap: 8px;">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="var(--admin-primary)" stroke-width="2.2"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
              Sankalp Photo Gallery — Recent Uploads
            </h3>
            <div style="display: flex; align-items: center; gap: 12px;">
              <a href="/admin/gallery/bulk" style="font-size: 12px; font-weight: 700; color: #c2410c; text-decoration: none;">
