              </div>
              <div style="flex: 1;">
                <div style="font-size: 13px; font-weight: 800;">Bulk Photo Upload</div>
                <div style="font-size: 11px; color: #991b1b; font-weight: 500;">Batch upload with State &amp; District</div>
              </div>
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
            </a>

            <!-- Add Single Photo -->
            <a href="/admin/gallery/new" class="dash-quick-action" style="background: #fbf7f4; color: var(--admin-text-dark); border-color: var(--admin-border);">
              <div class="dash-quick-icon" style="background: #f1eae5; color: var(--admin-text-dark);">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
              </div>
              <div style="flex: 1;">
                <div style="font-size: 13px; font-weight: 800;">Add Single Photo</div>
                <div style="font-size: 11px; color: var(--admin-text-muted); font-weight: 500;">With State &amp; District selectors</div>
              </div>
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
            </a>

            <!-- Social Media Wall -->
            <a href="/admin/social" class="dash-quick-action" style="background: #fdf2f8; color: #9d174d; border-color: #fbcfe8;">
              <div class="dash-quick-icon" style="background: #fce7f3; color: #be185d;">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 16.08c-.76 0-1.44.3-1.96.77L8.91 12.7c.05-.23.09-.46.09-.7s-.04-.47-.09-.7l7.05-4.11c.54.5 1.25.81 2.04.81 1.66 0 3-1.34 3-3s-1.34-3-3-3-3 1.34-3 3c0 .24.04.47.09.7L8.04 9.81C7.5 9.31 6.79 9 6 9c-1.66 0-3 1.34-3 3s1.34 3 3 3c.79 0 1.5-.31 2.04-.81l7.12 4.16c-.05.21-.08.43-.08.65 0 1.61 1.31 2.92 2.92 2.92s2.92-1.31 2.92-2.92c0-1.61-1.31-2.92-2.92-2.92z"/></svg>
              </div>
              <div style="flex: 1;">
                <div style="font-size: 13px; font-weight: 800;">Social Media Wall</div>
                <div style="font-size: 11px; color: #831843; font-weight: 500;">Post to Insta/FB/X &amp; auto-sync</div>
              </div>
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
            </a>

            <!-- Hero Sliders -->
            <a href="/admin/home/hero" class="dash-quick-action" style="background: #f8fafc; color: #1e293b; border-color: #e2e8f0;">
