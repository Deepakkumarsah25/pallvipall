    <!-- 3. REAL-TIME ACTIVITY: RECENT PLEDGES & INQUIRIES (FULL-WIDTH CARD) -->
    <div class="dash-inquiries-card">
      <div class="dash-inquiries-header">
        <h3 class="dash-inquiries-title">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="var(--admin-primary)" stroke-width="2.2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
          <span>Recent Pledges &amp; Inquiries</span>
          <span style="display: inline-flex; align-items: center; gap: 5px; font-size: 11px; font-weight: 700; background: #ecfdf5; color: #047857; padding: 2px 8px; border-radius: 12px; border: 1px solid #a7f3d0;">
            <span style="width: 6px; height: 6px; border-radius: 50%; background: #10b981; display: inline-block; animation: pulseDot 1.8s infinite;"></span>
            Real-time
          </span>
        </h3>
        <div style="display: flex; align-items: center; gap: 12px;">
          <a href="/admin/home/inquiries" style="font-size: 12px; font-weight: 700; color: var(--admin-primary); text-decoration: none; display: inline-flex; align-items: center; gap: 4px;">
            <span>View All Records (<%= stats.inquiriesTotal %>)</span>
            <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
          </a>
        </div>
      </div>

      <div class="dash-inquiries-wrapper">
        <table class="dash-table">
          <thead>
            <tr>
              <th style="min-width: 200px;">Participant</th>
              <th style="min-width: 150px;">Contact Number</th>
              <th style="min-width: 140px;">District / Region</th>
              <th style="min-width: 140px;">Form Type</th>
              <th style="min-width: 130px;">Date &amp; Time</th>
              <th style="min-width: 110px; text-align: center;">Status</th>
              <th style="min-width: 100px; text-align: center;">Quick Action</th>
            </tr>
          </thead>
          <tbody>
            <% if (recentInquiries && recentInquiries.length > 0) { %>
              <% recentInquiries.forEach(function(item) { %>
                <tr>
                  <!-- Participant -->
                  <td>
                    <div style="display: flex; align-items: center; gap: 12px;">
                      <div class="dash-avatar-circle">
                        <%= (item.name ? item.name.charAt(0) : 'N').toUpperCase() %>
                      </div>
                      <div>
                        <strong style="font-size: 13.5px; font-weight: 700; color: var(--admin-text-dark); display: block; line-height: 1.3;">
                          <%= item.name %>
                        </strong>
                        <span style="font-size: 11px; color: var(--admin-text-muted); display: block; line-height: 1.3;">
                          <%= item.category || (item.type === 'pledge' ? 'Online Pledge' : 'Support Inquiry') %>
                        </span>
                      </div>
                    </div>
                  </td>

                  <!-- Contact -->
                  <td>
                    <a href="tel:<%= item.phone %>" class="dash-phone-badge" title="Click to Call <%= item.phone %>">
                      <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                      <span><%= item.phone %></span>
                    </a>
                  </td>

                  <!-- District -->
                  <td>
                    <% if (item.district) { %>
                      <span class="dash-district-pill">
                        📍 <%= item.district %>
                      </span>
                    <% } else { %>
                      <span style="color: var(--admin-text-muted); font-size: 12px; font-weight: 500;">—</span>
                    <% } %>
                  </td>

                  <!-- Form Type -->
                  <td>
                    <span class="dash-type-pill <%= item.type === 'pledge' ? 'dash-type-pledge' : 'dash-type-support' %>">
                      <%= item.type === 'pledge' ? 'Sankalp Pledge' : (item.category || 'Support Inquiry') %>
                    </span>
                  </td>

                  <!-- Date & Time -->
                  <td>
                    <div style="line-height: 1.35;">
                      <div style="font-size: 12.5px; font-weight: 700; color: var(--admin-text-dark);">
                        <%= item.createdAt ? new Date(item.createdAt).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }) : '-' %>
                      </div>
                      <div style="font-size: 11px; color: var(--admin-text-muted);">
                        <%= item.createdAt ? new Date(item.createdAt).toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit', hour12: true }) : '' %>
                      </div>
                    </div>
                  </td>

                  <!-- Status -->
                  <td style="text-align: center;">
                    <span class="dash-status-pill <%= item.status === 'new' ? 'status-new' : (item.status === 'contacted' ? 'status-contacted' : 'status-resolved') %>">
                      <span class="status-dot"></span>
                      <%= item.status === 'new' ? 'New' : (item.status === 'contacted' ? 'Contacted' : 'Resolved') %>
                    </span>
                  </td>

                  <!-- Quick Action -->
                  <td style="text-align: center;">
                    <a href="/admin/home/inquiries" class="dash-action-btn" title="View details in inquiries">
                      <span>Details</span>
                      <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
                    </a>
                  </td>
                </tr>
              <% }); %>
            <% } else { %>
              <tr>
                <td colspan="7" style="text-align: center; padding: 40px; color: var(--admin-text-muted);">
                  <div style="font-size: 28px; margin-bottom: 6px;">📥</div>
                  <strong>No pledges or inquiries received yet.</strong>
                  <p style="font-size: 12px; margin-top: 4px;">Pledges submitted through the website form will appear here in real-time.</p>
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>

    <!-- 4. MAIN TWO-COLUMN CONTENT GRID -->
