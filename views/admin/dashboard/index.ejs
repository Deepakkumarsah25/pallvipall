                ✉️
              </div>
              <div>
                <span style="display: block; font-size: 11px; color: var(--admin-text-muted); font-weight: 600;">Email Support</span>
                <strong style="font-size: 12px; color: var(--admin-text-dark); word-break: break-all;"><%= quickInfo.helplineEmail || 'pallvipal.official@gmail.com' %></strong>
