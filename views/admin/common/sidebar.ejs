    isKalashActive=path.startsWith('/admin/kalash-yatra'); const isContactActive=path.startsWith('/admin/contact');
    const isGalleryActive=path.startsWith('/admin/gallery'); const isNewsActive=path.startsWith('/admin/video_news');
    const isAboutActive=path.startsWith('/admin/about'); %>

