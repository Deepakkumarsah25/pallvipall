            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
              <polyline points="6 9 12 15 18 9" />
            </svg>
          </span>
        </button>

        <div class="admin-sub-menu">
          <div class="admin-sub-menu-inner">
            <a href="/admin/contact?tab=messages"
              class="admin-sub-item <%= isContactActive && (tab === 'messages' || !tab) ? 'active' : '' %>">
              <span class="sub-bullet"></span>
              <span>1. Received Messages</span>
            </a>
            <a href="/admin/contact?tab=settings"
              class="admin-sub-item <%= isContactActive && tab === 'settings' ? 'active' : '' %>">
              <span class="sub-bullet"></span>
              <span>2. Page &amp; Office Info</span>
            </a>
          </div>
        </div>
      </div>

      <!-- 4. SANKALP GALLERY (Collapsible Accordion) -->
      <div class="admin-nav-group <%= isGalleryActive ? 'open active-group' : '' %>" id="group-gallery">
        <button type="button" class="admin-nav-item admin-nav-toggle" onclick="toggleNavGroup(this)"
          aria-expanded="<%= isGalleryActive ? 'true' : 'false' %>">
          <span class="nav-item-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
              <rect x="3" y="3" width="18" height="18" rx="2" />
              <circle cx="8.5" cy="8.5" r="1.5" />
              <polyline points="21 15 16 10 5 21" />
            </svg>
          </span>
          <span class="nav-item-label">Sankalp Gallery</span>
          <span class="nav-item-chevron">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
              <polyline points="6 9 12 15 18 9" />
            </svg>
          </span>
        </button>

        <div class="admin-sub-menu">
          <div class="admin-sub-menu-inner">
            <a href="/admin/gallery" class="admin-sub-item <%= path === '/admin/gallery' ? 'active' : '' %>">
              <span class="sub-bullet"></span>
              <span>Photo Gallery Hub</span>
            </a>
            <a href="/admin/gallery/bulk" class="admin-sub-item <%= path === '/admin/gallery/bulk' ? 'active' : '' %>">
              <span class="sub-bullet"></span>
              <span>+ Bulk Photo Upload</span>
            </a>
          </div>
        </div>
      </div>

      <!-- 5. ABOUT LEADER (PALLAVI PAL) -->
      <a href="/admin/about" class="admin-nav-item <%= isAboutActive ? 'active' : '' %>">
        <span class="nav-item-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
            <circle cx="12" cy="7" r="4" />
          </svg>
        </span>
        <span class="nav-item-label">About Leader (पल्लवी पाल)</span>
