        <span class="nav-item-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
            <rect x="3" y="3" width="7" height="7" rx="1" />
            <rect x="14" y="3" width="7" height="7" rx="1" />
            <rect x="3" y="14" width="7" height="7" rx="1" />
            <rect x="14" y="14" width="7" height="7" rx="1" />
          </svg>
        </span>
        <span class="nav-item-label">Dashboard</span>
      </a>

      <!-- News & Press (Direct Link) -->
      <a href="/admin/video_news" class="admin-nav-item <%= isNewsActive ? 'active' : '' %>">
        <span class="nav-item-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
            <path d="M4 5h16v14H4z" />
            <path d="M8 9h8M8 13h8M8 17h5" />
            <path d="m4 5 3 3" />
          </svg>
        </span>
        <span class="nav-item-label">News &amp; Press</span>
      </a>

      <!-- ==================== MODULES ==================== -->
      <div class="nav-group-title" style="margin-top: 18px;">PAGE MODULES</div>

      <!-- 1. HOME PAGE MANAGEMENT (Collapsible Accordion) -->
      <div class="admin-nav-group <%= isHomeActive ? 'open active-group' : '' %>" id="group-home">
