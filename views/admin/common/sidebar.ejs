      <!-- ==================== SYSTEM ==================== -->
      <div class="nav-group-title" style="margin-top: 18px;">QUICK LINKS</div>

      <!-- Live Website Link -->
      <a href="/" target="_blank" rel="noopener noreferrer" class="admin-nav-item">
        <span class="nav-item-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
