              <polyline points="9 22 9 12 15 12 15 22" />
            </svg>
          </span>
          <span class="nav-item-label">Home Page</span>
          <span class="nav-item-chevron">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
              <polyline points="6 9 12 15 18 9" />
            </svg>
          </span>
        </button>

        <div class="admin-sub-menu">
          <div class="admin-sub-menu-inner">
            <a href="/admin/home" class="admin-sub-item <%= path === '/admin/home' ? 'active' : '' %>">
              <span class="sub-bullet"></span>
              <span>Home Page Hub</span>
            </a>
            <a href="/admin/home/hero"
              class="admin-sub-item <%= path.startsWith('/admin/home/hero') ? 'active' : '' %>">
              <span class="sub-bullet"></span>
              <span>1. Hero Slider</span>
            </a>
            <a href="/admin/home/about"
              class="admin-sub-item <%= path.startsWith('/admin/home/about') ? 'active' : '' %>">
              <span class="sub-bullet"></span>
              <span>2. About Highlight</span>
            </a>
            <a href="/admin/home/initiatives"
              class="admin-sub-item <%= path.startsWith('/admin/home/initiatives') ? 'active' : '' %>">
              <span class="sub-bullet"></span>
              <span>3. Work &amp; Initiatives</span>
            </a>
            <a href="/admin/home/why-choose"
              class="admin-sub-item <%= path.startsWith('/admin/home/why-choose') ? 'active' : '' %>">
              <span class="sub-bullet"></span>
              <span>3. Pillars &amp; Commitments</span>
            </a>
            <a href="/admin/home/notices"
              class="admin-sub-item <%= path.startsWith('/admin/home/notices') ? 'active' : '' %>">
              <span class="sub-bullet"></span>
              <span>4. Notices &amp; Sidebar</span>
            </a>
            <a href="/admin/home/inquiries"
              class="admin-sub-item <%= path.startsWith('/admin/home/inquiries') ? 'active' : '' %>">
              <span class="sub-bullet"></span>
              <span>5. Pledges &amp; Inquiries</span>
