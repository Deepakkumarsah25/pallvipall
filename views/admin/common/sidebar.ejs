<!-- =====================================
     REUSABLE ADMIN SIDEBAR (COLLAPSIBLE ACCORDION & SUB-MENUS)
====================================== -->
<style>
  .admin-sidebar {
    width: var(--admin-sidebar-w, 260px);
    height: 100vh;
    position: fixed;
    left: 0;
    top: 0;
    display: flex;
    flex-direction: column;
    background: #ffffff;
    border-right: 1px solid var(--admin-border, #e2e8f0);
    z-index: 100;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: 2px 0 16px rgba(15, 23, 42, 0.03);
  }

  /* Logo Branding */
  .admin-sidebar-logo {
    height: 68px;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 0 18px;
    border-bottom: 1px solid var(--admin-border, #e2e8f0);
    flex-shrink: 0;
    background: #ffffff;
  }

  .admin-logo-mark {
    width: 36px;
    height: 36px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 9px;
    background: linear-gradient(135deg, var(--admin-primary, #dc2626), var(--admin-primary-dark, #b91c1c));
    color: #ffffff;
    font-size: 18px;
    font-weight: 800;
    box-shadow: 0 4px 12px rgba(220, 38, 38, 0.25);
  }

  .admin-logo-text strong {
    display: block;
    font-size: 14.5px;
    color: var(--admin-text-dark, #0f172a);
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: -0.2px;
  }

  .admin-logo-text small {
    display: block;
    font-size: 11px;
    color: var(--admin-text-muted, #64748b);
    font-weight: 600;
  }

  /* Navigation Container & Scrollbar */
  .admin-sidebar-nav {
    flex: 1;
    padding: 16px 12px;
    overflow-y: auto;
    overflow-x: hidden;
  }

  .admin-sidebar-nav::-webkit-scrollbar {
    width: 5px;
  }

  .admin-sidebar-nav::-webkit-scrollbar-track {
    background: transparent;
  }

  .admin-sidebar-nav::-webkit-scrollbar-thumb {
    background: #e2e8f0;
    border-radius: 99px;
  }

  .admin-sidebar-nav::-webkit-scrollbar-thumb:hover {
    background: #cbd5e1;
  }

  /* Section Titles */
  .nav-group-title {
    padding: 0 10px;
    margin: 16px 0 6px;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 1.1px;
    color: #94a3b8;
    text-transform: uppercase;
  }

  .nav-group-title:first-child {
    margin-top: 0;
  }

  /* Base Nav Item (Both Links & Buttons) */
  .admin-nav-item {
    position: relative;
    display: flex;
    align-items: center;
    gap: 11px;
    min-height: 40px;
    padding: 0 12px;
    margin-bottom: 3px;
    border-radius: 8px;
    color: #475569;
    font-size: 13px;
    font-weight: 600;
    text-decoration: none;
    transition: background 0.2s ease, color 0.2s ease, transform 0.15s ease;
    border: none;
    background: transparent;
    cursor: pointer;
    width: 100%;
    box-sizing: border-box;
    text-align: left;
    user-select: none;
  }

  .admin-nav-item:hover {
    background: #f8fafc;
    color: var(--admin-primary, #dc2626);
  }

  .admin-nav-item.active {
    background: #fef2f2;
    color: var(--admin-primary-dark, #b91c1c);
    font-weight: 700;
  }

  .admin-nav-item.active::before {
    content: "";
    position: absolute;
    left: 0;
    top: 6px;
    bottom: 6px;
    width: 3px;
    background: var(--admin-primary, #dc2626);
    border-radius: 0 4px 4px 0;
  }

  /* Main Nav Icon */
  .nav-item-icon {
    width: 20px;
    height: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    color: currentColor;
  }

  .nav-item-icon svg {
    width: 17px;
    height: 17px;
    stroke-width: 2;
  }

  .nav-item-label {
    flex: 1;
    min-width: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Chevron Arrow for Collapsible Items */
  .nav-item-chevron {
    width: 18px;
    height: 18px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    color: #94a3b8;
    transition: transform 0.25s cubic-bezier(0.4, 0, 0.2, 1), color 0.2s ease;
  }

  .nav-item-chevron svg {
    width: 13px;
    height: 13px;
    stroke-width: 2.4;
  }

  .admin-nav-group.open .nav-item-chevron {
    transform: rotate(180deg);
    color: var(--admin-primary, #dc2626);
  }

  /* Group Container */
  .admin-nav-group {
    margin-bottom: 4px;
  }

  .admin-nav-group.active-group>.admin-nav-toggle {
    color: var(--admin-primary-dark, #b91c1c);
    font-weight: 700;
    background: #fef2f2;
  }

  .admin-nav-group.active-group>.admin-nav-toggle::before {
    content: "";
    position: absolute;
    left: 0;
    top: 6px;
    bottom: 6px;
    width: 3px;
    background: var(--admin-primary, #dc2626);
    border-radius: 0 4px 4px 0;
  }

  /* Collapsible Sub-menu (CSS Grid Animation) */
  .admin-sub-menu {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .admin-nav-group.open .admin-sub-menu {
    grid-template-rows: 1fr;
  }

  .admin-sub-menu-inner {
    overflow: hidden;
    margin-left: 21px;
    padding-left: 12px;
    border-left: 1.5px solid #f1f5f9;
    padding-top: 2px;
    padding-bottom: 4px;
  }

  /* Sub Item */
  .admin-sub-item {
    display: flex;
    align-items: center;
    gap: 9px;
    min-height: 32px;
    padding: 5px 10px;
    margin: 2px 0;
    border-radius: 6px;
    color: #64748b;
    font-size: 12.5px;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.18s ease;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .admin-sub-item:hover {
    color: var(--admin-primary, #dc2626);
    background: #f8fafc;
    padding-left: 13px;
  }

  .admin-sub-item.active {
    color: var(--admin-primary-dark, #b91c1c);
    background: #fff5f5;
    font-weight: 700;
  }

  /* Sub Bullet Dot */
  .sub-bullet {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #cbd5e1;
    flex-shrink: 0;
    transition: all 0.2s ease;
  }

  .admin-sub-item:hover .sub-bullet {
    background: var(--admin-primary, #dc2626);
    transform: scale(1.25);
  }

  .admin-sub-item.active .sub-bullet {
    background: var(--admin-primary, #dc2626);
    box-shadow: 0 0 0 3px rgba(220, 38, 38, 0.18);
  }

  /* Badges */
  .nav-badge {
    margin-left: auto;
    padding: 2px 7px;
    border-radius: 12px;
    font-size: 10px;
    font-weight: 800;
    background: var(--admin-primary, #dc2626);
    color: #ffffff;
    line-height: 1.3;
  }

  /* Sidebar Bottom & Logout */
  .admin-sidebar-bottom {
    padding: 12px;
    border-top: 1px solid var(--admin-border, #e2e8f0);
    flex-shrink: 0;
    background: #ffffff;
  }

  .admin-logout-btn {
    display: flex;
    align-items: center;
    gap: 10px;
    width: 100%;
    padding: 9px 12px;
    border-radius: 8px;
    color: #991b1b;
    background: #fef2f2;
    border: 1px solid #fee2e2;
    font-size: 13px;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.2s ease;
    box-sizing: border-box;
  }

  .admin-logout-btn:hover {
    background: #fee2e2;
    border-color: #fca5a5;
    color: #7f1d1d;
  }

  /* Backdrop for Mobile */
  .admin-sidebar-backdrop {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(15, 23, 42, 0.5);
    z-index: 95;
    backdrop-filter: blur(2px);
  }

  @media (max-width: 1024px) {
    .admin-sidebar {
      transform: translateX(-100%);
    }

    .admin-sidebar.open {
      transform: translateX(0);
    }

    .admin-sidebar-backdrop.open {
      display: block;
    }
  }
</style>

<div class="admin-sidebar-backdrop" id="adminSidebarBackdrop"></div>

<aside class="admin-sidebar" id="adminSidebar">
  <!-- 1. BRAND LOGO -->
  <div class="admin-sidebar-logo">
    <div class="admin-logo-mark">N</div>
    <div class="admin-logo-text">
      <strong>Nishad Sankalp</strong>
      <small>Admin Management Hub</small>
    </div>
  </div>

  <% const path=typeof currentPath !=='undefined' ? currentPath : '' ; const tab=typeof activeTab !=='undefined' ?
