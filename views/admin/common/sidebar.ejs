            </svg>
          </span>
          <span class="nav-item-label">Sankalp Yatra</span>
          <span class="nav-item-chevron">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
              <polyline points="6 9 12 15 18 9" />
            </svg>
          </span>
        </button>

        <div class="admin-sub-menu">
          <div class="admin-sub-menu-inner">
            <a href="/admin/kalash-yatra"
              class="admin-sub-item <%= path.startsWith('/admin/kalash-yatra') ? 'active' : '' %>">
              <span class="sub-bullet"></span>
              <span>📹 Video Gallery</span>
            </a>
          </div>
        </div>
      </div>

      <!-- 3. CONTACT US MANAGEMENT (Collapsible Accordion) -->
      <div class="admin-nav-group <%= isContactActive ? 'open active-group' : '' %>" id="group-contact">
        <button type="button" class="admin-nav-item admin-nav-toggle" onclick="toggleNavGroup(this)"
          aria-expanded="<%= isContactActive ? 'true' : 'false' %>">
          <span class="nav-item-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
              <path
                d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" />
            </svg>
