<!-- Modal JavaScript -->
<script>
  function openMessageModal(btn) {
    const name = btn.getAttribute("data-name");
    const phone = btn.getAttribute("data-phone");
    const email = btn.getAttribute("data-email");
    const district = btn.getAttribute("data-district");
    const date = btn.getAttribute("data-date");
    const status = btn.getAttribute("data-status");
    const id = btn.getAttribute("data-id");
    const rawMsg = decodeURIComponent(btn.getAttribute("data-message"));

    document.getElementById("modalSenderName").textContent = name;
    document.getElementById("modalDate").textContent = "Received: " + date;

    const phoneLink = document.getElementById("modalPhoneLink");
    phoneLink.textContent = phone;
    phoneLink.href = "tel:" + phone;

    const waLink = document.getElementById("modalWaLink");
    const waClean = phone.replace(/[^0-9]/g, "");
    waLink.href = "https://wa.me/91" + waClean + "?text=" + encodeURIComponent("नमस्ते " + name + " जी, पल्लवी पाल जनसेवा कार्यालय से संपर्क कर रहे हैं।");

    const emailLink = document.getElementById("modalEmailLink");
    emailLink.textContent = email;
    emailLink.href = "mailto:" + email;

    document.getElementById("modalDistrict").textContent = district;
    document.getElementById("modalMessageContent").textContent = rawMsg;

    const statusBadge = document.getElementById("modalStatusBadge");
    if (status === "new") {
      statusBadge.innerHTML = '<span style="display:inline-block; font-size:11px; font-weight:800; padding:2px 8px; border-radius:4px; background:#fef3c7; color:#b45309;">🟡 New</span>';
    } else if (status === "contacted") {
      statusBadge.innerHTML = '<span style="display:inline-block; font-size:11px; font-weight:800; padding:2px 8px; border-radius:4px; background:#e0f2fe; color:#0369a1;">🔵 In Progress</span>';
    } else {
      statusBadge.innerHTML = '<span style="display:inline-block; font-size:11px; font-weight:800; padding:2px 8px; border-radius:4px; background:#ecfdf5; color:#047857;">🟢 Resolved</span>';
    }

    const modalForm = document.getElementById("modalStatusForm");
    modalForm.action = "/admin/contact/messages/status/" + id;
    document.getElementById("modalStatusSelect").value = status;

    document.getElementById("msgModalBackdrop").style.display = "block";
    document.getElementById("msgModal").style.display = "flex";
    document.body.style.overflow = "hidden";
  }

  function closeMessageModal() {
    document.getElementById("msgModalBackdrop").style.display = "none";
    document.getElementById("msgModal").style.display = "none";
    document.body.style.overflow = "";
  }

  document.addEventListener("keydown", function(e) {
    if (e.key === "Escape") {
      closeMessageModal();
    }
  });

  // Banner Live Preview Handlers
  function updateBannerHeadingPreview(val) {
    const el = document.getElementById("previewHeadingText");
    if (el) el.textContent = val.trim() || "Contact Us";
  }

  function previewBannerUrl(url) {
    const previewBox = document.getElementById("bannerLivePreview");
    if (!previewBox) return;
    const cleanUrl = (url || "").trim() || "/images/contact-banner.jpg";
    previewBox.style.backgroundImage = `linear-gradient(rgba(15,23,42,0.65), rgba(15,23,42,0.8)), url('${cleanUrl}')`;
  }

  function previewBannerUpload(input) {
    if (input.files && input.files[0]) {
      const reader = new FileReader();
      reader.onload = function(e) {
        const previewBox = document.getElementById("bannerLivePreview");
        if (previewBox) {
          previewBox.style.backgroundImage = `linear-gradient(rgba(15,23,42,0.65), rgba(15,23,42,0.8)), url('${e.target.result}')`;
        }
      };
      reader.readAsDataURL(input.files[0]);
    }
  }

  // Google Maps Dynamic Test Link Handler
  function updateMapTestLink(val) {
    const btn = document.getElementById("mapTestLinkBtn");
    if (!btn) return;
    const cleanUrl = (val || "").trim();
    if (cleanUrl && (cleanUrl.startsWith("http://") || cleanUrl.startsWith("https://"))) {
      btn.href = cleanUrl;
      btn.classList.remove("disabled");
      btn.style.pointerEvents = "auto";
      btn.style.opacity = "1";
    } else {
      btn.href = "#";
      btn.classList.add("disabled");
      btn.style.pointerEvents = "none";
      btn.style.opacity = "0.5";
    }
  }

  // WhatsApp Dynamic URL & Test Link Handler
  function updateWhatsappPreview() {
    const numInput = document.getElementById("whatsappNumber");
    const msgInput = document.getElementById("whatsappMessage");
    const previewText = document.getElementById("waPreviewLinkText");
    const testBtn = document.getElementById("waTestBtn");
    if (!numInput || !previewText || !testBtn) return;

    const rawNum = (numInput.value || "").trim().replace(/[^0-9]/g, "");
    const rawMsg = (msgInput ? msgInput.value : "").trim();
    if (rawNum) {
      const fullLink = `https://wa.me/${rawNum}${rawMsg ? `?text=${encodeURIComponent(rawMsg)}` : ""}`;
      previewText.textContent = fullLink;
      testBtn.href = fullLink;
      testBtn.classList.remove("disabled");
      testBtn.style.pointerEvents = "auto";
      testBtn.style.opacity = "1";
    } else {
      previewText.textContent = "कृपया मान्य व्हाट्सएप नंबर दर्ज करें (उदा. +91...)";
      testBtn.href = "#";
      testBtn.classList.add("disabled");
      testBtn.style.pointerEvents = "none";
      testBtn.style.opacity = "0.5";
    }
  }

  // Auto-initialize dynamic controls on page load
  document.addEventListener("DOMContentLoaded", function() {
    const mapInput = document.getElementById("mapDirectionsUrl");
    if (mapInput) updateMapTestLink(mapInput.value);

    const waInput = document.getElementById("whatsappNumber");
    if (waInput) updateWhatsappPreview();
  });
</script>
