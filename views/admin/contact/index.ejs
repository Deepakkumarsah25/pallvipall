<%- include("../common/header") %>
<%- include("../common/sidebar") %>

<div class="admin-main">
  <!-- Topbar -->
  <header class="admin-topbar">
    <div class="topbar-left">
      <button type="button" class="mobile-menu-trigger" id="adminMobileMenuBtn" aria-label="Menu">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
      </button>
      <div class="page-heading">
        <h1>
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="var(--admin-primary)" stroke-width="2.2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          Contact Us Management Hub
        </h1>
        <p>Live messages inbox, public inquiries, office addresses, and helpline configuration</p>
      </div>
    </div>
    <div class="topbar-right">
      <a href="/contact" target="_blank" class="view-site-btn">
        <span>View Live Contact Page</span>
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/></svg>
      </a>
      <div class="admin-user-pill">
        <div class="admin-user-avatar"><%= (admin && admin.name ? admin.name.charAt(0) : 'A').toUpperCase() %></div>
        <div class="admin-user-info">
          <strong><%= admin && admin.name ? admin.name : 'Admin' %></strong>
          <small><%= admin && admin.role ? admin.role : 'Superadmin' %></small>
        </div>
      </div>
    </div>
  </header>

  <!-- Body -->
  <div class="admin-body">

    <!-- Flash Alerts -->
    <% if (message) { %>
      <div class="admin-alert admin-alert-success">✓ <%= message %></div>
    <% } %>
    <% if (error) { %>
      <div class="admin-alert admin-alert-error">⚠ <%= error %></div>
    <% } %>

    <!-- Statistics Overview Grid -->
    <div class="contact-stats-grid">
      <div class="contact-stat-box stat-total">
        <div class="stat-box-icon" style="background: #f1f5f9; color: #475569;">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
        </div>
        <div class="stat-box-content">
          <strong><%= stats.total %></strong>
          <span>Total Messages</span>
        </div>
      </div>

      <div class="contact-stat-box stat-new">
        <div class="stat-box-icon" style="background: #fef3c7; color: #b45309;">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
        </div>
        <div class="stat-box-content">
          <strong style="color: #b45309;"><%= stats.new %></strong>
          <span>New / Unread</span>
        </div>
      </div>

      <div class="contact-stat-box stat-contacted">
        <div class="stat-box-icon" style="background: #e0f2fe; color: #0284c7;">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
        </div>
        <div class="stat-box-content">
          <strong style="color: #0284c7;"><%= stats.contacted %></strong>
          <span>In Progress / Contacted</span>
        </div>
      </div>

      <div class="contact-stat-box stat-resolved">
        <div class="stat-box-icon" style="background: #ecfdf5; color: #059669;">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
        </div>
        <div class="stat-box-content">
          <strong style="color: #059669;"><%= stats.resolved %></strong>
          <span>Resolved / Completed</span>
        </div>
      </div>
    </div>

    <!-- Navigation Tabs -->
    <div class="contact-tab-nav">
      <a href="/admin/contact?tab=messages" class="contact-tab-btn <%= activeTab === 'messages' ? 'active' : '' %>">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
        <span>Received Messages</span>
        <% if (stats.new > 0) { %>
          <span class="tab-badge-count"><%= stats.new %></span>
        <% } %>
      </a>

      <a href="/admin/contact?tab=settings" class="contact-tab-btn <%= activeTab === 'settings' ? 'active' : '' %>">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
        <span>Page &amp; Office Settings</span>
      </a>
    </div>

    <!-- =====================================================================
         TAB 1: RECEIVED MESSAGES INBOX
         ====================================================================== -->
    <% if (activeTab === 'messages') { %>
      <div class="admin-card">
        <div class="admin-card-header" style="flex-wrap: wrap; gap: 14px;">
          <div>
            <h3>
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
              Inbox Messages (<%= pagination.total %>)
            </h3>
            <span style="font-size: 12px; color: var(--admin-text-muted);">Real-time queries sent from public contact form</span>
          </div>

          <!-- Filters & Search -->
          <div class="inbox-actions-row">
            <!-- Filter Pills -->
            <div class="filter-pills-wrap">
              <a href="/admin/contact?tab=messages&status=all<%= filters.search ? '&search=' + encodeURIComponent(filters.search) : '' %>"
                class="filter-pill <%= filters.status === 'all' ? 'active' : '' %>">
                All (<%= stats.total %>)
              </a>
              <a href="/admin/contact?tab=messages&status=new<%= filters.search ? '&search=' + encodeURIComponent(filters.search) : '' %>"
                class="filter-pill pill-new <%= filters.status === 'new' ? 'active' : '' %>">
                🟡 New (<%= stats.new %>)
              </a>
              <a href="/admin/contact?tab=messages&status=contacted<%= filters.search ? '&search=' + encodeURIComponent(filters.search) : '' %>"
                class="filter-pill pill-contacted <%= filters.status === 'contacted' ? 'active' : '' %>">
                🔵 In Progress (<%= stats.contacted %>)
              </a>
              <a href="/admin/contact?tab=messages&status=resolved<%= filters.search ? '&search=' + encodeURIComponent(filters.search) : '' %>"
                class="filter-pill pill-resolved <%= filters.status === 'resolved' ? 'active' : '' %>">
                🟢 Resolved (<%= stats.resolved %>)
              </a>
            </div>

            <!-- Search Bar -->
            <form action="/admin/contact" method="GET" class="search-form-wrap">
              <input type="hidden" name="tab" value="messages" />
              <% if (filters.status && filters.status !== 'all') { %>
                <input type="hidden" name="status" value="<%= filters.status %>" />
              <% } %>
              <div class="search-input-box">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                <input type="text" name="search" class="search-field" placeholder="Search by name, phone, city..." value="<%= filters.search || '' %>" />
                <% if (filters.search) { %>
                  <a href="/admin/contact?tab=messages&status=<%= filters.status %>" class="clear-search-btn" title="Clear Search">×</a>
                <% } %>
              </div>
              <button type="submit" class="btn-admin btn-admin-sm btn-admin-primary">Search</button>
            </form>
          </div>
        </div>

        <!-- Table Wrapper -->
        <div class="admin-table-wrapper">
          <table class="admin-table contact-messages-table">
            <thead>
              <tr>
                <th style="width: 130px;">Date &amp; Time</th>
                <th style="width: 170px;">Sender</th>
                <th style="width: 190px;">Communication</th>
                <th>Message Content</th>
                <th style="width: 140px; text-align: center;">Status</th>
                <th style="width: 100px; text-align: center;">Action</th>
              </tr>
            </thead>
            <tbody>
              <% if (messages && messages.length > 0) { %>
                <% messages.forEach(function(msg) { %>
                  <tr class="message-row <%= msg.status === 'new' ? 'row-unread' : '' %>" id="msg-row-<%= msg._id %>">
                    <!-- 1. Date & Time -->
                    <td>
                      <div class="msg-date-main">
                        <%= new Date(msg.createdAt).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }) %>
                      </div>
                      <div class="msg-date-time">
                        <%= new Date(msg.createdAt).toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit' }) %>
                      </div>
                    </td>

                    <!-- 2. Sender -->
                    <td>
                      <div class="msg-sender-name"><%= msg.name %></div>
                      <% if (msg.district) { %>
                        <div class="msg-sender-district">
                          <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                          <span><%= msg.district %></span>
                        </div>
                      <% } %>
                    </td>

                    <!-- 3. Channels / Communication -->
                    <td>
                      <div class="comm-channel-stack">
                        <!-- Call Link -->
                        <a href="tel:<%= msg.phone %>" class="comm-btn comm-phone" title="कॉल करें">
                          <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                          <span><%= msg.phone %></span>
                        </a>

                        <!-- WhatsApp Direct Link -->
                        <% const waTarget = (msg.phone || '').replace(/[^0-9]/g, ''); %>
                        <a href="https://wa.me/91<%= waTarget %>?text=<%= encodeURIComponent('नमस्ते ' + msg.name + ' जी, पल्लवी पाल जनसेवा कार्यालय से संपर्क कर रहे हैं।') %>"
                           target="_blank" rel="noopener noreferrer" class="comm-btn comm-wa" title="WhatsApp चैट शुरू करें">
                          <svg viewBox="0 0 24 24" width="12" height="12" fill="currentColor"><path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0 0 12.04 2zm5.79 14.12c-.24.68-1.39 1.3-1.93 1.38-.49.07-1.13.1-3.28-.79-2.58-1.07-4.22-3.69-4.35-3.86-.13-.17-1.05-1.4-1.05-2.67 0-1.27.67-1.89.91-2.14.24-.25.53-.31.71-.31.18 0 .36 0 .52.01.17.01.4.06.6.53.22.52.74 1.82.81 1.95.07.13.11.29.02.47-.09.18-.14.29-.27.45-.13.16-.28.36-.4.48-.13.13-.27.27-.12.53.15.26.68 1.12 1.46 1.81 1 .89 1.84 1.17 2.1 1.3.26.13.41.11.56-.06.15-.17.65-.76.82-1.02.17-.26.35-.22.59-.13.24.09 1.52.72 1.78.85.26.13.43.2.49.31.06.11.06.66-.18 1.34z"/></svg>
                          <span>WhatsApp</span>
                        </a>

                        <!-- Email Link -->
                        <% if (msg.email) { %>
                          <a href="mailto:<%= msg.email %>" class="comm-btn comm-email" title="<%= msg.email %>">
                            <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                            <span style="max-width: 140px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;"><%= msg.email %></span>
                          </a>
                        <% } %>
                      </div>
                    </td>

                    <!-- 4. Message Body -->
                    <td>
                      <div class="msg-snippet">
                        <%= msg.message %>
                      </div>
                      <button type="button" class="view-msg-btn"
                        data-name="<%= msg.name %>"
                        data-phone="<%= msg.phone %>"
                        data-email="<%= msg.email %>"
                        data-district="<%= msg.district || 'उल्लेखित नहीं' %>"
                        data-date="<%= new Date(msg.createdAt).toLocaleString('en-IN') %>"
                        data-status="<%= msg.status %>"
                        data-id="<%= msg._id %>"
                        data-message="<%= encodeURIComponent(msg.message) %>"
                        onclick="openMessageModal(this)">
                        पूरा संदेश देखें &raquo;
                      </button>
                    </td>

                    <!-- 5. Status Selector -->
                    <td style="text-align: center;">
                      <form action="/admin/contact/messages/status/<%= msg._id %>" method="POST" class="status-change-form">
                        <select name="status" class="status-dropdown status-<%= msg.status %>" onchange="this.form.submit()">
                          <option value="new" <%= msg.status === 'new' ? 'selected' : '' %>>🟡 New</option>
                          <option value="contacted" <%= msg.status === 'contacted' ? 'selected' : '' %>>🔵 In Progress</option>
                          <option value="resolved" <%= msg.status === 'resolved' ? 'selected' : '' %>>🟢 Resolved</option>
                        </select>
                      </form>
                    </td>

                    <!-- 6. Actions -->
                    <td style="text-align: center;">
                      <form action="/admin/contact/messages/delete/<%= msg._id %>" method="POST" onsubmit="return confirm('क्या आप इस संदेश को स्थायी रूप से हटाना चाहते हैं?');" style="display:inline; margin: 0;">
                        <button type="submit" class="btn-sm-action btn-del" title="हटाएं">
                          <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                          <span>Delete</span>
                        </button>
                      </form>
                    </td>
                  </tr>
                <% }); %>
              <% } else { %>
                <tr>
                  <td colspan="6">
                    <div class="empty-state-box">
                      <svg viewBox="0 0 24 24" width="48" height="48" fill="none" stroke="#cbd5e1" stroke-width="1.8"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                      <h4>कोई संदेश नहीं मिला</h4>
                      <p>वर्तमान फ़िल्टर या खोज मानदंड के अनुसार कोई संदेश उपलब्ध नहीं है।</p>
                    </div>
                  </td>
                </tr>
              <% } %>
            </tbody>
          </table>
          <%- include("../common/pagination", { pagination, paginationPath, paginationQuery }) %>
        </div>
      </div>
    <% } %>

    <!-- =====================================================================
         TAB 2: PAGE INFORMATION & SETTINGS
         ====================================================================== -->
    <% if (activeTab === 'settings') { %>
      <form action="/admin/contact/settings" method="POST" enctype="multipart/form-data" id="contactSettingsForm">
        <div class="settings-form-layout">

          <!-- Intro Info Banner -->
          <div class="settings-intro-banner">
            <div class="settings-intro-left">
              <div class="settings-intro-icon">
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
              </div>
              <div class="settings-intro-text">
                <h3>पेज एवं कार्यालय सूचना प्रबंधन (Page &amp; Office Info)</h3>
                <p>सार्वजनिक संपर्क पेज (Contact Page) के शीर्ष बैनर, केंद्रीय कार्यालय का पता, गूगल मैप लिंक, हेल्पलाइन, व्हाट्सएप एवं सोशल हैंडल्स को यहाँ से आसानी से अपडेट करें।</p>
              </div>
            </div>
            <a href="/contact" target="_blank" rel="noopener noreferrer" class="btn-live-preview-pill" title="लाइव वेबसाइट संपर्क पेज खोलें">
              <span>लाइव पेज देखें</span>
              <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/></svg>
            </a>
          </div>

          <!-- Card 1: Top Banner Settings -->
          <div class="admin-card settings-card">
            <div class="admin-card-header">
              <div class="card-header-left">
                <div class="card-header-badge badge-indigo">
                  <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
                </div>
                <div class="card-header-titles">
                  <h3>1. Top Banner Settings (शीर्ष बैनर)</h3>
                  <p>वेबसाइट के मुख्य संपर्क पेज का शीर्ष बैनर शीर्षक एवं पृष्ठभूमि छवि</p>
                </div>
              </div>
              <span class="card-step-tag">Section 1/5</span>
            </div>

            <div class="settings-grid">
              <div class="form-group-full">
                <label class="admin-form-label" for="pageHeading">
                  <span class="label-title">Banner Main Heading (बैनर मुख्य शीर्षक)</span>
                  <span class="label-badge label-required">आवश्यक</span>
                </label>
                <input type="text" id="pageHeading" name="pageHeading" class="form-control" value="<%= contact.pageHeading || 'Contact Us' %>" required oninput="updateBannerHeadingPreview(this.value)" placeholder="उदा. Contact Us या हमसे संपर्क करें" />
                <span class="field-hint">
