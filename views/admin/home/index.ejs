<%- include("../common/header") %>
<%- include("../common/sidebar") %>

<div class="admin-main">
  <!-- Topbar -->
  <header class="admin-topbar">
    <div class="topbar-left">
      <button type="button" class="mobile-menu-trigger" id="adminMobileMenuBtn" aria-label="Menu">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
      </button>
      <div class="page-heading">
        <h1>
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="var(--admin-primary)" stroke-width="2.2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
          Home Page Content Manager
        </h1>
      </div>
    </div>
    <div class="topbar-right">
      <a href="/" target="_blank" class="view-site-btn">
        <span>View Live Website</span>
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/></svg>
      </a>
      <div class="admin-user-pill">
        <div class="admin-user-avatar"><%= (admin && admin.name ? admin.name.charAt(0) : 'A').toUpperCase() %></div>
        <div class="admin-user-info">
          <strong><%= admin && admin.name ? admin.name : 'Admin' %></strong>
          <small><%= admin && admin.role ? admin.role : 'Superadmin' %></small>
        </div>
      </div>
    </div>
  </header>

  <!-- Body -->
  <div class="admin-body">
    <!-- Quick Statistics Grid -->
    <style>
      .home-stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 16px;
        margin-bottom: 28px;
      }
      .home-stat-box {
        background: #ffffff;
        border: 1px solid var(--admin-border);
        border-radius: 12px;
        padding: 18px 20px;
        display: flex;
        align-items: center;
        gap: 16px;
        box-shadow: 0 4px 14px rgba(0,0,0,0.02);
      }
      .stat-box-icon {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        background: var(--admin-primary-light);
        color: var(--admin-primary);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
      }
      .stat-box-icon svg {
        width: 24px;
        height: 24px;
      }
      .stat-box-content strong {
        display: block;
        font-size: 24px;
        font-weight: 800;
        color: var(--admin-text-dark);
        line-height: 1.1;
      }
      .stat-box-content span {
        font-size: 12px;
        color: var(--admin-text-muted);
        font-weight: 600;
      }

      .modules-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 20px;
      }
      .module-card {
        background: #ffffff;
        border: 1px solid var(--admin-border);
        border-radius: 14px;
        padding: 24px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        transition: transform 0.2s, box-shadow 0.2s;
      }
      .module-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 24px rgba(215, 42, 42, 0.08);
        border-color: var(--admin-primary-border);
      }
      .module-header {
        display: flex;
        align-items: flex-start;
        gap: 16px;
        margin-bottom: 16px;
      }
      .module-icon {
        width: 44px;
        height: 44px;
        border-radius: 10px;
        background: linear-gradient(135deg, var(--admin-primary), var(--admin-primary-dark));
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
      }
      .module-icon svg {
        width: 22px;
        height: 22px;
      }
      .module-title h3 {
        font-size: 16px;
        font-weight: 800;
        color: var(--admin-text-dark);
        margin-bottom: 4px;
      }
      .module-title p {
        font-size: 13px;
        color: var(--admin-text-muted);
        line-height: 1.5;
      }
      .module-actions {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-top: 18px;
        padding-top: 16px;
        border-top: 1px solid var(--admin-border-subtle);
      }

      @media (max-width: 1150px) {
        .home-stats-grid {
          grid-template-columns: repeat(2, 1fr);
        }
      }
      @media (max-width: 1024px) {
        .modules-grid {
          grid-template-columns: 1fr;
        }
      }
      @media (max-width: 600px) {
        .home-stats-grid {
          grid-template-columns: 1fr;
          gap: 12px;
        }
        .module-card {
          padding: 18px;
        }
        .module-actions {
          flex-direction: column;
          align-items: stretch;
        }
        .module-actions a {
          text-align: center;
          justify-content: center;
        }
      }
    </style>

    <div class="home-stats-grid">
      <div class="home-stat-box">
        <div class="stat-box-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
        </div>
        <div class="stat-box-content">
          <strong><%= stats.heroSlidesCount %></strong>
          <span>Hero Slides</span>
        </div>
      </div>

      <div class="home-stat-box">
        <div class="stat-box-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>
        </div>
        <div class="stat-box-content">
          <strong><%= stats.initiativesCount %></strong>
          <span>Work & Initiatives</span>
        </div>
      </div>

      <div class="home-stat-box">
        <div class="stat-box-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        </div>
        <div class="stat-box-content">
          <strong><%= stats.pillarsCount %></strong>
          <span>Core Pillars</span>
        </div>
      </div>

      <div class="home-stat-box">
        <div class="stat-box-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
        </div>
        <div class="stat-box-content">
          <strong><%= stats.noticesCount %></strong>
          <span>Active Notices</span>
        </div>
      </div>

      <div class="home-stat-box">
        <div class="stat-box-icon" style="background: #fff8e6; color: #b45309;">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 20H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h10l5 5v11a2 2 0 0 1-2 2z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
        </div>
        <div class="stat-box-content">
          <strong><%= typeof stats.newsCount !== 'undefined' ? stats.newsCount : 0 %></strong>
          <span>News (<%= typeof stats.newsHighlightCount !== 'undefined' ? stats.newsHighlightCount : 0 %> Highlight)</span>
        </div>
      </div>
    </div>

    <!-- Manager Sections Grid -->
    <div class="modules-grid">
      <!-- 1. Hero Slider Manager -->
      <div class="module-card">
        <div>
          <div class="module-header">
            <div class="module-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
            </div>
            <div class="module-title">
              <h3>1. Main Hero Slider</h3>
              <p>Manage the full-screen hero banner, headlines, taglines, background photos, and call-to-action buttons.</p>
            </div>
          </div>
        </div>
        <div class="module-actions">
          <a href="/admin/home/hero" class="btn-admin btn-admin-primary">
            <span>Manage Sliders</span>
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
          <a href="/admin/home/hero/new" class="btn-admin btn-admin-outline">Add New Slide</a>
        </div>
      </div>

      <!-- 2. Home About Highlight Section -->
      <div class="module-card">
        <div>
          <div class="module-header">
            <div class="module-icon" style="background: linear-gradient(135deg, #e11d48, #be123c);">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
            </div>
            <div class="module-title">
              <h3>2. About Highlight Section (स्लाइडर के नीचे अभियान परिचय)</h3>
              <p>स्लाइडर के तुरंत नीचे दिखने वाले अभियान परिचय, मुख्य चित्र, चार स्तम्भ, आंकड़े और विवरण को संपादित करें।</p>
            </div>
          </div>
        </div>
        <div class="module-actions">
          <a href="/admin/home/about" class="btn-admin btn-admin-primary" style="background: linear-gradient(135deg, #e11d48, #be123c);">
            <span>Edit About Section</span>
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
          <a href="/#home-about" target="_blank" class="btn-admin btn-admin-outline">Live Preview</a>
        </div>
      </div>

      <!-- 3. What We Do & Initiatives Manager -->
      <div class="module-card">
        <div>
          <div class="module-header">
            <div class="module-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>
            </div>
            <div class="module-title">
              <h3>2. Work & Initiatives (What We Do)</h3>
              <p>Manage the 6 initiative cards, descriptions, details, and interactive modal content.</p>
            </div>
          </div>
        </div>
        <div class="module-actions">
          <a href="/admin/home/initiatives" class="btn-admin btn-admin-primary">
            <span>Manage Initiatives</span>
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
          <a href="/admin/home/initiatives/new" class="btn-admin btn-admin-outline">Add New Card</a>
        </div>
      </div>

      <!-- 3. Why Choose Us Section -->
      <div class="module-card">
        <div>
          <div class="module-header">
            <div class="module-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            </div>
            <div class="module-title">
              <h3>3. Pillars & Commitments (Why Choose Us)</h3>
              <p>Edit the 4 core trust pillars, inspirational quote, and commitment card highlights.</p>
            </div>
          </div>
        </div>
        <div class="module-actions">
          <a href="/admin/home/why-choose" class="btn-admin btn-admin-primary">
            <span>Edit Commitments Section</span>
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
        </div>
      </div>

      <!-- 4. Notices & Quick Sidebar -->
      <div class="module-card">
        <div>
          <div class="module-header">
            <div class="module-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
            </div>
            <div class="module-title">
              <h3>4. Notices & Sidebar Contact</h3>
              <p>Manage live ticker notices, camp dates, helpline numbers, email address, and pledge dock settings.</p>
            </div>
          </div>
        </div>
        <div class="module-actions">
          <a href="/admin/home/notices" class="btn-admin btn-admin-primary">
            <span>Edit Notices & Contact</span>
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
        </div>
      </div>

      <!-- 5. User Inquiries & Pledges -->
      <div class="module-card">
        <div>
          <div class="module-header">
            <div class="module-icon" style="background: linear-gradient(135deg, #10b981, #059669);">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
            </div>
            <div class="module-title">
              <h3>5. Received Pledges & Inquiries</h3>
              <p>View pledge submissions, visitor inquiries, and support requests. (<%= stats.newInquiriesCount %> new requests)</p>
            </div>
          </div>
        </div>
        <div class="module-actions">
          <a href="/admin/home/inquiries" class="btn-admin btn-admin-primary">
            <span>View All Pledges & Inquiries (<%= stats.inquiriesCount %>)</span>
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
        </div>
      </div>

      <!-- 6. Sankalp Photo Gallery Manager -->
      <div class="module-card">
        <div>
          <div class="module-header">
            <div class="module-icon" style="background: linear-gradient(135deg, #8b5cf6, #6d28d9);">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
            </div>
            <div class="module-title">
              <h3>6. Sankalp Photo Gallery Management</h3>
              <p>Manage, edit, publish/draft, and bulk upload pledge photos from various districts.</p>
            </div>
          </div>
        </div>
        <div class="module-actions">
          <a href="/admin/gallery" class="btn-admin btn-admin-primary" style="background: linear-gradient(135deg, #8b5cf6, #6d28d9);">
            <span>Manage Gallery (<%= typeof stats.photosCount !== 'undefined' ? stats.photosCount : 0 %>)</span>
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
          <a href="/admin/gallery/bulk" class="btn-admin btn-admin-outline">Bulk Upload</a>
        </div>
      </div>

      <!-- 7. News & Media Coverage Manager -->
      <div class="module-card">
        <div>
          <div class="module-header">
            <div class="module-icon" style="background: linear-gradient(135deg, #e1306c, #f77737);">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 16.08c-.76 0-1.44.3-1.96.77L8.91 12.7c.05-.23.09-.46.09-.7s-.04-.47-.09-.7l7.05-4.11c.54.5 1.25.81 2.04.81 1.66 0 3-1.34 3-3s-1.34-3-3-3-3 1.34-3 3c0 .24.04.47.09.7L8.04 9.81C7.5 9.31 6.79 9 6 9c-1.66 0-3 1.34-3 3s1.34 3 3 3c.79 0 1.5-.31 2.04-.81l7.12 4.16c-.05.21-.08.43-.08.65 0 1.61 1.31 2.92 2.92 2.92s2.92-1.31 2.92-2.92c0-1.61-1.31-2.92-2.92-2.92z"/></svg>
            </div>
            <div class="module-title">
              <h3>7. Social Media Wall &amp; Accounts (सोशल मीडिया)</h3>
              <p>Manage Instagram, Facebook, and Twitter feeds. Publish multi-platform posts at once and link account credentials for auto-fetching.</p>
            </div>
          </div>
        </div>
        <div class="module-actions">
          <a href="/admin/social" class="btn-admin btn-admin-primary" style="background: linear-gradient(135deg, #e1306c, #833ab4);">
            <span>Manage Social Wall (<%= typeof stats.socialCount !== 'undefined' ? stats.socialCount : 0 %>)</span>
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
          <a href="/admin/social#compose" class="btn-admin btn-admin-outline">New Post</a>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include("../common/footer") %>
