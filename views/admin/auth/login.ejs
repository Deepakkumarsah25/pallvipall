<!DOCTYPE html>
<html lang="en">

<head>

  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <title>Admin Login | Pallavi Pal Official</title>
  <meta name="robots" content="noindex, nofollow, noarchive" />
  <link rel="icon" type="image/png" href="/images/logo.png" />


  <style>

    /* ========================================
       RESET
    ======================================== */

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }


    html {
      scroll-behavior: smooth;
    }


    body {
      min-height: 100vh;
      font-family:
        Inter,
        "Segoe UI",
        Arial,
        sans-serif;

      background:
        linear-gradient(
          135deg,
          #fffaf5 0%,
          #fbf4ec 50%,
          #f6e9dd 100%
        );

      color: #352727;
    }


    button,
    input {
      font: inherit;
    }


    /* ========================================
       MAIN PAGE
    ======================================== */

    .login-page {
      min-height: 100vh;

      display: flex;
      align-items: center;
      justify-content: center;

      padding: 30px;
    }


    /* ========================================
       MAIN CONTAINER
    ======================================== */

    .login-container {
      width: 100%;
      max-width: 1100px;
      min-height: 650px;

      display: grid;
      grid-template-columns: 1fr 1fr;

      background: #ffffff;

      border-radius: 28px;

      overflow: hidden;

      box-shadow:
        0 25px 70px rgba(90, 45, 30, 0.14),
        0 8px 25px rgba(90, 45, 30, 0.06);

      border: 1px solid rgba(215, 42, 42, 0.08);
    }


    /* ========================================
       LEFT SIDE
    ======================================== */

    .login-info {
      position: relative;

      display: flex;
      flex-direction: column;

      justify-content: space-between;

      padding: 55px;

      background:
        linear-gradient(
          145deg,
          #8c1a1a 0%,
          #b91f1f 45%,
          #d72a2a 100%
        );

      color: #ffffff;

      overflow: hidden;
    }


    /* Decorative circles */

    .login-info::before {
      content: "";

      position: absolute;

      width: 330px;
      height: 330px;

      border-radius: 50%;

      background: rgba(255, 255, 255, 0.06);

      top: -150px;
      right: -120px;
    }


    .login-info::after {
      content: "";

      position: absolute;

      width: 250px;
      height: 250px;

      border-radius: 50%;

      background: rgba(255, 255, 255, 0.05);

      bottom: -130px;
      left: -100px;
    }


    /* ========================================
       BRAND
    ======================================== */

    .brand {
      position: relative;
      z-index: 2;

      display: flex;
      align-items: center;

      gap: 14px;
    }


    .brand-logo {
      width: 58px;
      height: 58px;
      flex-shrink: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 50%;
      background: #ffffff;
      border: 2px solid rgba(255, 255, 255, 0.4);
      box-shadow: 0 4px 16px rgba(0, 0, 0, 0.15);
      overflow: hidden;
      padding: 4px;
    }

    .brand-logo img {
      width: 100%;
      height: 100%;
      object-fit: contain;
      display: block;
    }


    .brand-text h1 {
      font-size: 22px;

      line-height: 1.3;

      font-weight: 800;

      color: #ffffff;
    }


    .brand-text p {
      margin-top: 4px;

      font-size: 13px;

      color: rgba(255, 255, 255, 0.75);

      letter-spacing: 0.8px;
    }


    /* ========================================
       INFO CONTENT
    ======================================== */

    .info-content {
      position: relative;
      z-index: 2;

      max-width: 450px;

      margin-top: auto;
      margin-bottom: auto;
    }


    .small-title {
      display: inline-block;

      margin-bottom: 18px;

      font-size: 12px;

      font-weight: 800;

      letter-spacing: 2px;

      color: rgba(255, 255, 255, 0.7);
    }


    .info-content h2 {
      font-size: 43px;

      line-height: 1.15;

      font-weight: 800;

      letter-spacing: -1px;

      color: #ffffff;
    }


    .info-content h2 span {
      display: block;

      margin-top: 5px;

      color: #ffe2c9;
    }


    .info-content p {
      max-width: 420px;

      margin-top: 25px;

      font-size: 15px;

      line-height: 1.8;

      color: rgba(255, 255, 255, 0.78);
    }


    /* ========================================
       LEFT FOOTER
    ======================================== */

    .info-footer {
      position: relative;
      z-index: 2;

      display: flex;
      align-items: center;
      gap: 12px;

      font-size: 12px;

      color: rgba(255, 255, 255, 0.65);
    }


    .info-footer span:first-child {
      padding-right: 12px;

      border-right: 1px solid rgba(255, 255, 255, 0.25);
    }


    /* ========================================
       RIGHT SIDE
    ======================================== */

    .login-card-wrapper {
      display: flex;
      align-items: center;
      justify-content: center;

      padding: 55px;

      background: #ffffff;
    }


    .login-card {
      width: 100%;
      max-width: 420px;
    }


    /* ========================================
       LOGIN HEADER
    ======================================== */

    .login-header {
      margin-bottom: 30px;
    }


    .mobile-logo {
      display: none;
      width: 54px;
      height: 54px;
      align-items: center;
      justify-content: center;
      margin-bottom: 18px;
      border-radius: 50%;
      background: #ffffff;
      border: 1.5px solid #ebdcd5;
      box-shadow: 0 4px 14px rgba(0, 0, 0, 0.08);
      overflow: hidden;
      padding: 4px;
    }

    .mobile-logo img {
      width: 100%;
      height: 100%;
      object-fit: contain;
      display: block;
    }


    .login-header h2 {
      font-size: 32px;

      line-height: 1.2;

      font-weight: 800;

      color: #3f2929;
    }


    .login-header p {
      margin-top: 9px;

      font-size: 14px;

      color: #8b7770;
    }


    /* ========================================
       ALERT
    ======================================== */

    .alert {
      display: flex;
      align-items: center;

      gap: 10px;

      padding: 13px 15px;

      margin-bottom: 22px;

      border-radius: 11px;

      font-size: 13px;

      line-height: 1.5;
    }


    .alert-icon {
      width: 23px;
      height: 23px;

      flex-shrink: 0;

      display: flex;
      align-items: center;
      justify-content: center;

      border-radius: 50%;

      font-weight: 800;
    }


    .alert-error {
      background: #fff1f1;

      border: 1px solid #ffd4d4;

      color: #b42323;
    }


    .alert-error .alert-icon {
      background: #d72a2a;

      color: #ffffff;
    }


    .alert-success {
      background: #effaf2;

      border: 1px solid #ccebd4;

      color: #28733b;
    }


    .alert-success .alert-icon {
      background: #35a853;

      color: #ffffff;
    }


    /* ========================================
       FORM
    ======================================== */

    .login-form {
      width: 100%;
    }


    .form-group {
      margin-bottom: 22px;
    }


    .form-group label {
      display: block;

      margin-bottom: 9px;

      font-size: 13px;

      font-weight: 700;

      color: #4d3939;
    }


    .password-label {
      display: flex;
      align-items: center;
      justify-content: space-between;

      margin-bottom: 9px;
    }


    .password-label label {
      margin-bottom: 0;
    }


    .forgot-password {
      font-size: 12px;

      font-weight: 600;

      color: #d72a2a;

      text-decoration: none;

      transition: 0.2s ease;
    }


    .forgot-password:hover {
      color: #8c1a1a;

      text-decoration: underline;
    }


    /* ========================================
       INPUT
    ======================================== */

    .input-wrapper {
      position: relative;

      display: flex;
      align-items: center;
    }


    .input-icon {
      position: absolute;

      left: 15px;

      width: 20px;
      height: 20px;

      display: flex;
      align-items: center;
      justify-content: center;

      color: #a28e87;

      pointer-events: none;
    }


    .input-icon svg {
      width: 19px;
      height: 19px;
    }


    .input-wrapper input {
      width: 100%;

      height: 52px;

      padding: 0 48px;

      border: 1px solid #e3d8d1;

      border-radius: 12px;

      outline: none;

      background: #fffdfb;

      color: #352727;

      font-size: 14px;

      transition:
        border-color 0.2s ease,
        box-shadow 0.2s ease,
        background 0.2s ease;
    }


    .input-wrapper input::placeholder {
      color: #b2a39c;
    }


    .input-wrapper input:hover {
      border-color: #d5c5bc;
    }


    .input-wrapper input:focus {
      background: #ffffff;

      border-color: #d72a2a;

      box-shadow:
        0 0 0 4px rgba(215, 42, 42, 0.08);
    }


    /* ========================================
       PASSWORD TOGGLE
    ======================================== */

    .password-toggle {
      position: absolute;

      right: 8px;

      top: 50%;

      transform: translateY(-50%);

      width: 38px;
      height: 38px;

      display: flex;
      align-items: center;
      justify-content: center;

      border: none;

      border-radius: 9px;

      background: transparent;

      color: #9d8981;

      cursor: pointer;

      transition: 0.2s ease;
    }


    .password-toggle:hover {
      background: #fff0eb;

      color: #d72a2a;
    }


    .password-toggle svg {
      width: 19px;
      height: 19px;
    }


    /* ========================================
       FORM OPTIONS
    ======================================== */

    .form-options {
      display: flex;
      align-items: center;
      justify-content: space-between;

      margin-top: -3px;

      margin-bottom: 24px;
    }


    .remember-me {
      display: flex;
      align-items: center;

      gap: 9px;

      cursor: pointer;

      font-size: 13px;

      color: #75645e;
    }


    .remember-me input {
      position: absolute;

      opacity: 0;

      pointer-events: none;
    }


    .custom-checkbox {
      width: 18px;
      height: 18px;

      flex-shrink: 0;

      border: 1.5px solid #d5c5bc;

      border-radius: 5px;

      background: #ffffff;

      position: relative;

      transition: 0.2s ease;
    }


    .remember-me input:checked + .custom-checkbox {
      background: #d72a2a;

      border-color: #d72a2a;
    }


    .remember-me input:checked + .custom-checkbox::after {
      content: "";

      position: absolute;

      left: 5px;
      top: 2px;

      width: 5px;
      height: 9px;

      border: solid #ffffff;

      border-width: 0 2px 2px 0;

      transform: rotate(45deg);
    }


    /* ========================================
       LOGIN BUTTON
    ======================================== */

    .login-button {
      width: 100%;

      height: 54px;

      display: flex;
      align-items: center;
      justify-content: center;

      position: relative;

      border: none;

      border-radius: 12px;

      background:
        linear-gradient(
          135deg,
          #d72a2a,
          #b91f1f
        );

      color: #ffffff;

      font-size: 14px;

      font-weight: 700;

      cursor: pointer;

      box-shadow:
        0 9px 22px rgba(215, 42, 42, 0.22);

      transition:
        transform 0.2s ease,
        box-shadow 0.2s ease,
        opacity 0.2s ease;
    }


    .login-button:hover {
      transform: translateY(-2px);

      box-shadow:
        0 13px 28px rgba(215, 42, 42, 0.28);
    }


    .login-button:active {
      transform: translateY(0);
    }


    .button-text {
      transition: 0.2s ease;
    }


    .button-arrow {
      position: absolute;

      right: 18px;

      width: 19px;
      height: 19px;

      transition: 0.2s ease;
    }


    .login-button:hover .button-arrow {
      transform: translateX(3px);
    }


    /* ========================================
       LOADER
    ======================================== */

    .button-loader {
      display: none;

      align-items: center;

      gap: 4px;
    }


    .button-loader span {
      width: 5px;
      height: 5px;

      border-radius: 50%;

      background: #ffffff;

      animation: loadingDots 1s infinite ease-in-out;
    }


    .button-loader span:nth-child(2) {
      animation-delay: 0.15s;
    }


    .button-loader span:nth-child(3) {
      animation-delay: 0.3s;
    }


    .login-button.loading {
      pointer-events: none;

      opacity: 0.85;
    }


    .login-button.loading .button-text,
    .login-button.loading .button-arrow {
      display: none;
    }


    .login-button.loading .button-loader {
      display: flex;
    }


    @keyframes loadingDots {

      0%,
      80%,
      100% {
        transform: scale(0.65);

        opacity: 0.5;
      }

      40% {
        transform: scale(1);

        opacity: 1;
      }
    }


    /* ========================================
       SECURITY NOTE
    ======================================== */

    .security-note {
      display: flex;
      align-items: center;
      justify-content: center;

      gap: 8px;

      margin-top: 25px;

      font-size: 11px;

      color: #9b8982;
    }


    .security-note svg {
      width: 16px;
      height: 16px;

      color: #4fa568;
    }


    /* ========================================
       TABLET
    ======================================== */

    @media (max-width: 900px) {

      .login-page {
        padding: 20px;
      }


      .login-container {
        max-width: 760px;

        grid-template-columns: 1fr;

        min-height: auto;
      }


      .login-info {
        min-height: 260px;

        padding: 35px;
      }


      .info-content {
        margin-top: 45px;
      }


      .info-content h2 {
        font-size: 34px;
      }


      .info-content p {
        margin-top: 15px;
      }


      .info-footer {
        margin-top: 30px;
      }


      .login-card-wrapper {
        padding: 45px 35px;
      }

    }


    /* ========================================
       MOBILE
    ======================================== */

    @media (max-width: 600px) {

      .login-page {
        min-height: 100vh;

        padding: 0;

        align-items: stretch;
      }


      .login-container {
        width: 100%;

        border-radius: 0;

        border: none;

        box-shadow: none;
      }


      .login-info {
        min-height: 230px;

        padding: 28px 22px;
      }


      .brand-logo {
        width: 45px;
        height: 45px;

        border-radius: 12px;

        font-size: 21px;
      }


      .brand-text h1 {
        font-size: 17px;
      }


      .brand-text p {
        font-size: 11px;
      }


      .info-content {
        margin-top: 30px;
      }


      .small-title {
        margin-bottom: 10px;

        font-size: 10px;

        letter-spacing: 1.5px;
      }


      .info-content h2 {
        font-size: 27px;

        letter-spacing: -0.5px;
      }


      .info-content p {
        display: none;
      }


      .info-footer {
        display: none;
      }


      .login-card-wrapper {
        padding: 35px 22px 30px;

        align-items: flex-start;
      }


      .login-header {
        margin-bottom: 25px;
      }


      .mobile-logo {
        display: flex;
      }


      .login-header h2 {
        font-size: 27px;
      }


      .login-header p {
        font-size: 13px;
      }


      .form-group {
        margin-bottom: 19px;
      }


      .input-wrapper input {
        height: 50px;
      }


      .login-button {
        height: 52px;
      }

    }


    /* ========================================
       SMALL MOBILE
    ======================================== */

    @media (max-width: 380px) {

      .login-info {
        min-height: 215px;

        padding: 23px 18px;
      }


      .brand-text h1 {
        font-size: 15px;
      }


      .info-content h2 {
        font-size: 24px;
      }


      .login-card-wrapper {
        padding: 28px 18px;
      }


      .login-header h2 {
        font-size: 25px;
      }


      .form-options {
        margin-bottom: 20px;
      }

    }


    /* ========================================
       REDUCED MOTION
    ======================================== */

    @media (prefers-reduced-motion: reduce) {

      *,
      *::before,
      *::after {
        animation-duration: 0.01ms !important;

        animation-iteration-count: 1 !important;

        transition-duration: 0.01ms !important;
      }

    }

  </style>

</head>


<body>

  <main class="login-page">

    <div class="login-container">


      <!-- =====================================
           LEFT SIDE
      ====================================== -->

      <section class="login-info">

        <div class="brand">

          <div class="brand-logo">
            <img src="/images/logo.png" alt="पल्लवी पाल - Pallavi Pal" />
          </div>

          <div class="brand-text">

            <h1>
              Pallavi Pal Official
            </h1>

            <p>
              Admin Panel
            </p>

          </div>

        </div>


        <div class="info-content">

          <span class="small-title">
            WELCOME BACK
          </span>

          <h2>

            Welcome to

            <span>
              Admin Panel
            </span>

          </h2>

          <p>
            Manage home content, about details, gallery media, social posts, and
            contact inquiries all from one centralized dashboard.
          </p>

        </div>


        <div class="info-footer">

          <span>
            © <%= new Date().getFullYear() %>
          </span>

          <span>
            Pallavi Pal Official
          </span>

        </div>

      </section>


      <!-- =====================================
           RIGHT SIDE
      ====================================== -->

      <section class="login-card-wrapper">

        <div class="login-card">


          <!-- HEADER -->

          <div class="login-header">

            <div class="mobile-logo">
              <img src="/images/logo.png" alt="पल्लवी पाल - Pallavi Pal" />
            </div>

            <h2>
              Admin Login
            </h2>

            <p>
              Sign in with your Admin Account
            </p>

          </div>


          <!-- ERROR -->

          <% if (typeof error !== "undefined" && error) { %>

            <div class="alert alert-error">

              <span class="alert-icon">
                !
              </span>

              <span>
                <%= error %>
              </span>

            </div>

          <% } %>


          <!-- SUCCESS -->

          <% if (typeof success !== "undefined" && success) { %>

            <div class="alert alert-success">

              <span class="alert-icon">
                ✓
              </span>

              <span>
                <%= success %>
              </span>

            </div>

          <% } %>


          <!-- FORM -->

          <form
            action="<%= typeof loginAction !== 'undefined' ? loginAction : '/admin/pallavipal/main/login' %>"
            method="POST"
            class="login-form"
            id="loginForm"
          >


            <!-- EMAIL -->

            <div class="form-group">

              <label for="email">
                Email Address
              </label>

              <div class="input-wrapper">

                <span class="input-icon">

                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                  >

                    <rect
                      x="3"
                      y="5"
                      width="18"
                      height="14"
                      rx="2"
                    />

                    <path d="m3 7 9 6 9-6" />

                  </svg>

                </span>


                <input
                  type="email"
                  id="email"
                  name="email"
                  placeholder="admin@example.com"
                  autocomplete="email"
                  required
                />

              </div>

            </div>


            <!-- PASSWORD -->

            <div class="form-group">

              <div class="password-label">

                <label for="password">
                  Password
                </label>

                <a
                  href="#"
                  class="forgot-password"
                >
                  Forgot Password?
                </a>

              </div>


              <div class="input-wrapper">

                <span class="input-icon">

                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                  >

                    <rect
                      x="4"
                      y="10"
                      width="16"
                      height="10"
                      rx="2"
                    />

                    <path
                      d="M8 10V7a4 4 0 0 1 8 0v3"
                    />

                  </svg>

                </span>


                <input
                  type="password"
                  id="password"
                  name="password"
                  placeholder="Enter your password"
                  autocomplete="current-password"
                  required
                />


                <button
                  type="button"
                  class="password-toggle"
                  id="togglePassword"
                  aria-label="Show password"
                >

                  <svg
                    id="eyeIcon"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                  >

                    <path
                      d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z"
                    />

                    <circle
                      cx="12"
                      cy="12"
                      r="3"
                    />

                  </svg>

                </button>

              </div>

            </div>


            <!-- REMEMBER -->

            <div class="form-options">

              <label class="remember-me">

                <input
                  type="checkbox"
                  name="remember"
                  value="true"
                />

                <span class="custom-checkbox"></span>

                <span>
                  Remember me
                </span>

              </label>

            </div>


            <!-- LOGIN BUTTON -->

            <button
              type="submit"
              class="login-button"
              id="loginButton"
            >

              <span class="button-text">
                Login to Admin Panel
              </span>


              <span
                class="button-loader"
                id="buttonLoader"
              >

                <span></span>
                <span></span>
                <span></span>

              </span>


              <svg
                class="button-arrow"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >

                <path d="M5 12h14" />

                <path d="m13 6 6 6-6 6" />

              </svg>

            </button>

          </form>


          <!-- SECURITY -->

          <div class="security-note">

            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >

              <path
                d="M12 3 5 6v5c0 4.5 2.9 8.5 7 10 4.1-1.5 7-5.5 7-10V6l-7-3Z"
              />

              <path d="m9 12 2 2 4-4" />

            </svg>

            <span>
              Your connection is secure
            </span>

          </div>

        </div>

      </section>

    </div>

  </main>


  <script>

    /* ========================================
       PASSWORD SHOW / HIDE
    ======================================== */

    const passwordInput =
      document.getElementById("password");

    const togglePassword =
      document.getElementById("togglePassword");

    const eyeIcon =
      document.getElementById("eyeIcon");


    if (passwordInput && togglePassword) {

      togglePassword.addEventListener(
        "click",
        () => {

          const isPassword =
            passwordInput.type === "password";

          passwordInput.type =
            isPassword
              ? "text"
              : "password";


          togglePassword.setAttribute(
            "aria-label",
            isPassword
              ? "Hide password"
              : "Show password"
          );


          eyeIcon.innerHTML =
            isPassword

              ? `
                <path
                  d="M3 3l18 18"
                />

                <path
                  d="M10.6 10.6a2 2 0 0 0 2.8 2.8"
                />

                <path
                  d="M9.9 4.2A10.8 10.8 0 0 1 12 4c6.5 0 10 8 10 8a17.2 17.2 0 0 1-3.2 4.5"
                />

                <path
                  d="M6.6 6.6C3.8 8.6 2 12 2 12s3.5 8 10 8a9.8 9.8 0 0 0 4.2-.9"
                />
              `

              : `
                <path
                  d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z"
                />

                <circle
                  cx="12"
                  cy="12"
                  r="3"
                />
              `;

        }
      );

    }


    /* ========================================
       LOGIN LOADING
    ======================================== */

    const loginForm =
      document.getElementById("loginForm");

    const loginButton =
      document.getElementById("loginButton");


    if (loginForm && loginButton) {

      loginForm.addEventListener(
        "submit",
        () => {

          loginButton.classList.add(
            "loading"
          );

        }
      );

    }


    /* ========================================
       FORGOT PASSWORD
    ======================================== */

    const forgotPassword =
      document.querySelector(
        ".forgot-password"
      );


    if (forgotPassword) {

      forgotPassword.addEventListener(
        "click",
        (event) => {

          event.preventDefault();

          alert(
            "Password reset feature is currently unavailable. Please contact the administrator."
          );

        }
      );

    }

  </script>

</body>

