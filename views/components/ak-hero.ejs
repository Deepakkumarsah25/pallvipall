<!-- ==========================================================================
     ARVIND KEJRIWAL AAP STYLE HERO BANNER SLIDER
     Aspect Ratio 16/9 on Mobile, 50-55vh on Desktop, Left-aligned Bold Text
     ========================================================================== -->
<section class="ak-hero-wrapper" id="home" aria-label="Main Hero Slider">
  <div class="ak-hero-slider" id="akHeroSlider">

    <!-- Previous / Next Controls -->
    <button type="button" class="ak-hero-arrow prev" id="akHeroPrevBtn" aria-label="Previous Slide">
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
    </button>
    <button type="button" class="ak-hero-arrow next" id="akHeroNextBtn" aria-label="Next Slide">
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
    </button>

    <% if (typeof heroSlides !== 'undefined' && heroSlides && heroSlides.length > 0) { %>
      <% heroSlides.forEach(function(slide, idx) { %>
        <div class="ak-hero-slide <%= idx === 0 ? 'active' : '' %>" data-index="<%= idx %>">
          <img
            src="<%= slide.imageUrl %>"
            alt="<%= slide.tag || slide.headingPrefix || 'Nishad Sankalp Campaign' %>"
            class="ak-hero-bg"
            loading="<%= idx === 0 ? 'eager' : 'lazy' %>"
          />
          <div class="ak-hero-overlay"></div>

          <div class="ak-container" style="height: 100%;">
            <div class="ak-hero-content">
              <% if (slide.tag || slide.badgeText) { %>
                <div class="ak-hero-badge">
                  <span>★</span>
                  <span><%= slide.tag || slide.badgeText %></span>
                </div>
              <% } %>

              <<%= idx === 0 ? 'h1' : 'h2' %> class="ak-hero-title">
                <%= slide.headingPrefix || 'निषाद आरक्षण' %>
                <% if (slide.highlightText) { %>
                  <span class="ak-highlight"><%= slide.highlightText %></span>
                <% } %>
                <%= slide.headingSuffix || 'महा-अभियान' %>
              </<%= idx === 0 ? 'h1' : 'h2' %>>

              <% if (slide.subtitle || slide.headingPrefix) { %>
                <h3 class="ak-hero-subtitle">
                  <%= slide.subtitle || 'एकता, शिक्षा, संवैधानिक अधिकार व सामाजिक स्वाभिमान' %>
                </h3>
              <% } %>

              <% if (slide.description) { %>
                <p class="ak-hero-desc">
                  <%= slide.description %>
                </p>
              <% } %>

              <div class="ak-hero-actions">
                <a
                  href="<%= slide.primaryBtnLink || '#journey' %>"
                  class="ak-pill-btn"
                  <%= slide.primaryBtnInitiative ? 'data-initiative="' + slide.primaryBtnInitiative + '"' : '' %>
                >
                  <span><%= slide.primaryBtnText || 'अभियान से जुड़ें' %></span>
                  <span>→</span>
                </a>

                <a
                  href="<%= slide.secondaryBtnLink || '#about' %>"
                  class="ak-pill-btn secondary"
                >
                  <span><%= slide.secondaryBtnText || 'हमारे बारे में जानें' %></span>
                  <span>↓</span>
                </a>
              </div>
            </div>
          </div>
        </div>
      <% }); %>
    <% } %>

    <!-- Slide Indicator Dots -->
    <div class="ak-hero-dots" id="akHeroDots">
      <% if (typeof heroSlides !== 'undefined' && heroSlides && heroSlides.length > 0) { %>
        <% heroSlides.forEach(function(_, idx) { %>
          <button type="button" class="ak-hero-dot <%= idx === 0 ? 'active' : '' %>" data-slide="<%= idx %>" aria-label="Slide <%= idx + 1 %>"></button>
        <% }); %>
      <% } else { %>
        <button type="button" class="ak-hero-dot active" data-slide="0" aria-label="Slide 1"></button>
      <% } %>
    </div>

  </div>
</section>
