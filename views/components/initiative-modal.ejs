<!-- ==========================================================================
     INITIATIVE ACTION MODAL - Dynamic Modal for What-We-Do Cards
     ========================================================================== -->
<div class="initiative-modal-backdrop" id="initiativeModalBackdrop" role="dialog" aria-modal="true" aria-hidden="true">
  <div class="initiative-modal-window">
    
    <!-- Modal Header -->
    <div class="initiative-modal-header">
      <div class="modal-header-left">
        <div class="modal-category-icon">
          <svg viewBox="0 0 24 24"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>
        </div>
        <div>
          <span class="modal-category-tag" id="modalCategoryTag">Initiative & Service</span>
          <h3 class="modal-title" id="modalTitle">Initiative Details</h3>
        </div>
      </div>
      <button type="button" class="modal-close-btn" id="initiativeModalClose" aria-label="Close">
        <svg viewBox="0 0 24 24"><path d="M18 6L6 18M6 6l12 12" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/></svg>
      </button>
    </div>

    <!-- Modal Body -->
    <div class="initiative-modal-body">
      
      <!-- Overview Description -->
      <p class="modal-overview-desc" id="modalDesc">
        Loading details...
      </p>

      <!-- Key Highlights Card -->
      <div class="modal-highlights-card">
        <div class="modal-card-label">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="var(--primary-red)"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
          <span>Key Features & Benefits:</span>
        </div>
        <ul class="modal-highlights-list" id="modalHighlightsList">
          <!-- Dynamically populated -->
        </ul>
      </div>

      <!-- Helpline Direct Contact -->
      <div class="modal-helpline-row">
        <a href="tel:+919955309029" class="modal-helpline-btn" id="modalHelplineBtn">
          <svg viewBox="0 0 24 24"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          <span id="modalHelplineText">Direct Helpline Contact</span>
        </a>
      </div>

      <!-- Quick Action Form -->
      <div class="modal-form-card">
        <h4 class="modal-form-title" id="modalFormTitle">Quick Online Registration & Support</h4>
        <p class="modal-form-sub">Please fill in your details; our team representative will contact you within 24 hours.</p>

        <form id="initiativeActionForm">
          <input type="hidden" id="initiativeCategoryInput" name="category" value="" />
          
          <div class="modal-form-grid">
            <div class="modal-field">
              <label for="modalUserName">Full Name *</label>
              <input type="text" id="modalUserName" placeholder="Enter your full name" required />
            </div>

            <div class="modal-field">
              <label for="modalUserPhone">Phone Number *</label>
              <input type="tel" id="modalUserPhone" placeholder="10-digit mobile number" pattern="[0-9]{10}" required />
            </div>

            <div class="modal-field">
              <label for="modalUserDistrict">District / Block *</label>
              <input type="text" id="modalUserDistrict" placeholder="e.g. Prayagraj, Varanasi, etc." required />
            </div>

            <div class="modal-field">
              <label for="modalUserRole">Type of Support</label>
              <select id="modalUserRole">
                <option value="inquiry">Need Information / Help</option>
                <option value="volunteer">Join as a Volunteer</option>
                <option value="student">Student / Career Guidance</option>
                <option value="contribute">Support & Contribution</option>
              </select>
            </div>

            <div class="modal-field full-width">
              <label for="modalUserMessage">Message or Specific Need (Optional)</label>
              <textarea id="modalUserMessage" placeholder="Write your message or inquiry here..."></textarea>
            </div>
          </div>

          <button type="submit" class="ny-btn ny-btn-primary modal-submit-btn">
            <span id="modalSubmitBtnText">Submit Request</span>
            <svg viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" fill="none"/></svg>
          </button>
        </form>

        <div class="modal-success-banner" id="modalSuccessBanner">
          ✓ Your request and details have been submitted successfully. Our team will contact you shortly.
        </div>
      </div>

    </div>

    <!-- Modal Footer -->
    <div class="initiative-modal-footer">
      <span>पल्लवी पाल - जनसेवा व विकास पहल</span>
      <span>Secure & Free Service</span>
    </div>

  </div>
</div>
