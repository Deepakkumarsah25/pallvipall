<!-- ==========================================================================
     ARVIND KEJRIWAL AAP STYLE ABOUT & LEADER SECTION
     Signature Section Header (Xn), 2-Column Responsive Layout, Read More CTA
     ========================================================================== -->
<% const aboutData = (typeof homeAbout !== 'undefined' && homeAbout) ? homeAbout : {}; %>
<section class="ak-section ak-bg-alt" id="about">
  <div class="ak-container">

    <!-- Signature Section Header -->
    <div class="ak-section-header">
      <div class="ak-header-icon-box">
        <svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor">
          <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
        </svg>
      </div>
      <h2 class="ak-header-title">
        हमारे बारे में <span class="ak-highlight">About Leader & Mission</span>
      </h2>
    </div>

    <div class="ak-about-grid">
      <!-- Left Column: Visual Highlight -->
      <div class="ak-about-visual">
        <div class="ak-about-img-frame">
          <% 
            const mainImg = (aboutData.images && aboutData.images.length > 0) 
              ? aboutData.images[0] 
              : (aboutData.imageUrl || '/images/about/nishad-sankalp-rally.jpg');
          %>
          <img 
            src="<%= mainImg %>" 
            alt="Nishad Sankalp Campaign Leader Highlight" 
            loading="lazy"
            onerror="this.src='/images/about/nishad-sankalp-rally.jpg'"
          />
          <div class="ak-about-badge">
            <span style="font-size: 1.1rem;">🔥</span>
            <span><%= aboutData.floatingBadgeText || 'स्वाभिमान व सामाजिक चेतना' %></span>
          </div>
        </div>
      </div>

      <!-- Right Column: Narrative & Mission Points -->
      <div class="ak-about-content">
        <h3 class="ak-about-heading">
          <%= (aboutData.quoteText && aboutData.quoteText.trim()) 
              ? aboutData.quoteText 
              : 'जब समाज का एक-एक हाथ साथ जुड़ता है, तो इतिहास की दिशा बदल जाती है। निषाद संकल्प अभियान आपकी आवाज है।' %>
        </h3>

        <% if (aboutData.tagline && aboutData.tagline.trim()) { %>
          <p class="ak-about-text" style="font-weight: 600; color: var(--ak-primary);">
            <%= aboutData.tagline %>
          </p>
        <% } %>

        <p class="ak-about-text">
          यह अभियान केवल चुनावी राजनीति का हिस्सा नहीं, बल्कि समाज के अंतिम पायदान पर खड़े प्रत्येक नागरिक तक शिक्षा, संवैधानिक आरक्षण, सम्मान और आर्थिक स्वावलंबन पहुँचाने का एक पवित्र और ऐतिहासिक संकल्प है।
        </p>

        <!-- Bullet Highlights -->
        <ul class="ak-about-points">
          <% 
            const pointsList = (aboutData.points && aboutData.points.length > 0) ? aboutData.points : [
              { title: 'निःशुल्क सदस्यता एवं पारदर्शी भागीदारी' },
              { title: 'गांव व ब्लॉक स्तर पर प्रत्यक्ष संवाद व लोक-पंचायत' },
              { title: 'संवैधानिक आरक्षण व कानूनी अधिकारों की सशक्त पैरवी' },
              { title: 'युवाओं के लिए शिक्षा, कौशल विकास व रोजगार मार्गदर्शन' }
            ];
          %>
          <% pointsList.forEach(function(pt) { %>
            <li>
              <span class="ak-point-check">✓</span>
              <span><%= pt.title || pt %></span>
            </li>
          <% }); %>
        </ul>

        <!-- Read More Button -->
        <div class="ak-about-cta">
          <a href="/about" class="ak-pill-btn">
            <span>Read More</span>
            <span>→</span>
          </a>
        </div>
      </div>
    </div>

  </div>
</section>
