<!-- ==========================================================================
     ABOUT & LEADER SECTION - DR. PALLAVI PATEL (PALLAVI PAL)
     Signature Section Header, 2-Column Responsive Layout, Read More CTA
     ========================================================================== -->
<% const aboutData = (typeof homeAbout !== 'undefined' && homeAbout) ? homeAbout : {}; %>
<section class="ak-section ak-bg-alt" id="about">
  <div class="ak-container">

    <!-- Signature Section Header -->
    <div class="ak-section-header">
      <div class="ak-header-icon-box">
        <svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor">
          <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
        </svg>
      </div>
      <h2 class="ak-header-title">
        हमारे बारे में <span class="ak-highlight">About The Pallavi Pal</span>
      </h2>
    </div>

    <div class="ak-about-grid">
      <!-- Left Column: Visual Highlight -->
      <div class="ak-about-visual">
        <div class="ak-about-img-frame">
          <% 
            const mainImg = (aboutData.images && aboutData.images.length > 0) 
              ? aboutData.images[0] 
              : (aboutData.imageUrl || '/images/about/pallavi-pal-rally.jpg');
          %>
          <img 
            src="<%= mainImg %>" 
            alt="डॉ. पल्लवी पटेल (पल्लवी पाल) - जनसेवा एवं सामाजिक न्याय" 
            loading="lazy"
            onerror="this.src='/images/about/pallavi-pal-rally.jpg'"
          />
          <div class="ak-about-badge">
            <span style="font-size: 1.1rem;">🔥</span>
            <span>जनप्रतिनिधि • डॉ. पल्लवी पटेल</span>
          </div>
        </div>
      </div>

      <!-- Right Column: Narrative & Mission Points -->
      <div class="ak-about-content">
        <h3 class="ak-about-heading">
          संवैधानिक अधिकारों, सामाजिक न्याय और जन-जन के सम्मान के लिए सड़क से सदन तक समर्पित नेतृत्व।
        </h3>

        <p class="ak-about-text" style="font-weight: 600; color: var(--ak-primary);">
          समाजवादी विचारधारा, सामाजिक समरसता और कमेरा समाज के सम्मान व स्वाभिमान का संकल्प।
        </p>

        <p class="ak-about-text">
          डॉ. पल्लवी पटेल (पल्लवी पाल) समाजवादी विचारधारा और सामाजिक न्याय के सिद्धांतों को समर्पित एक प्रखर व जनप्रिय जननेत्री हैं। उत्तर प्रदेश के सिराथू (कौशाम्बी) विधानसभा से विधायक के रूप में, उन्होंने सदैव किसान, मजदूर, युवा, महिला और समाज के अंतिम पायदान पर खड़े प्रत्येक नागरिक के संवैधानिक अधिकारों, सम्मान और सर्वांगीण विकास के लिए सदन से लेकर सड़क तक पूरी दृढ़ता से आवाज उठाई है। उनका राजनीतिक व सामाजिक जीवन जनसेवा, लोकतांत्रिक मूल्यों और संविधान की रक्षा के लिए समर्पित है।
        </p>

        <!-- Bullet Highlights -->
        <ul class="ak-about-points">
          <li>
            <span class="ak-point-check">✓</span>
            <span>समाजवादी विचारधारा एवं सामाजिक न्याय का सशक्त संकल्प</span>
          </li>
          <li>
            <span class="ak-point-check">✓</span>
            <span>विधानसभा सदन में जनहित व संवैधानिक अधिकारों की निर्भीक पैरवी</span>
          </li>
          <li>
            <span class="ak-point-check">✓</span>
            <span>किसान, मजदूर, कामगार एवं कमेरा समाज का आर्थिक व सामाजिक सशक्तिकरण</span>
          </li>
          <li>
            <span class="ak-point-check">✓</span>
            <span>युवाओं के लिए रोजगार, गुणवत्तापूर्ण शिक्षा व महिला स्वावलंबन</span>
          </li>
        </ul>

        <!-- Read More Button -->
        <div class="ak-about-cta">
          <a href="/about" class="ak-pill-btn">
            <span>Read More</span>
            <span>→</span>
          </a>
        </div>
      </div>
    </div>

  </div>
</section>
