<!-- ==========================================================================
     HOME PAGE GALLERY RAIL SECTION (CAMPAIGN PHOTOS)
     Single-row horizontal rail (8 photos max) with auto-slide & swipe
     Card UI matching the official Gallery Page design
     ========================================================================== -->
<%
  const photos = (typeof galleryPhotos !== 'undefined' && Array.isArray(galleryPhotos)) ? galleryPhotos.slice(0, 8) : [];
%>

<section class="ak-section ak-bg-white" id="gallery">
  <div class="ak-container">

    <!-- Signature Section Header with Rail Navigation Controls -->
    <div class="ak-section-header-row">
      <div class="ak-section-header">
        <div class="ak-header-icon-box">
          <svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor">
            <path d="M21 19V5c0-1.1-.9-2-2-2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2zM8.5 13.5l2.5 3.01L14.5 12l4.5 6H5l3.5-4.5z"/>
          </svg>
        </div>
        <h2 class="ak-header-title">
          फोटो <span class="ak-highlight">Gallery</span>
        </h2>
      </div>

      <!-- Link Arrow navigating to Gallery Page -->
      <div class="rail-header-action">
        <a href="/gallery" class="rail-header-arrow-link" aria-label="View Full Gallery" title="गैलरी देखें">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </a>
      </div>
    </div>


    <!-- Horizontal Scroll Track Wrapper (Single row, right-to-left auto slide & touch swipe) -->
    <div class="social-track-wrap ak-cards-scroll-wrap" id="galleryRail">
      <div class="ak-gallery-cards-track">
        <% photos.forEach(function(photo, index) { %>
          <% 
            const photoDateStr = photo.formattedDate || (photo.date ? new Date(photo.date).toLocaleDateString('hi-IN', { day: 'numeric', month: 'short', year: 'numeric' }) : '');
            const photoLocation = photo.district || photo.state || 'उत्तर प्रदेश';
            const photoTitle = photo.name || 'कार्यक्रम झलक';
            const photoDesc = photo.caption || 'पल्लवी पाल जी के नेतृत्व में जनसेवा व विकास कार्यक्रम की विशेष झलक।';
          %>
          <article class="gallery-card home-gallery-rail-card">
            <a href="/gallery" class="home-gallery-card-link" aria-label="<%= photoTitle %>">
              <!-- IMAGE CONTAINER WITH TOP BADGES (MATCHING GALLERY PAGE) -->
              <div class="gallery-card-media">
                <div class="gallery-card-img-box">
                  <img 
                    src="<%= photo.imageUrl || '/images/kalash-yatra-featured.jpg' %>" 
                    alt="<%= photoTitle %>" 
                    loading="lazy"
                    onerror="this.onerror=null; this.src='/images/kalash-yatra-featured.jpg';"
                  />
                  <!-- OVERLAY GRADIENT & TOP BADGES -->
                  <div class="card-media-overlay"></div>
                  
                  <div class="card-top-badges">
                    <span class="card-location-badge">📍 <%= photoLocation %></span>
                    <% if (photoDateStr) { %>
                      <span class="card-date-badge">📅 <%= photoDateStr %></span>
                    <% } %>
                  </div>

                  <div class="card-fullscreen-hint" title="गैलरी में देखें">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2">
                      <path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"/>
                    </svg>
                  </div>
                </div>
              </div>

              <!-- CARD BODY: TITLE & DESCRIPTION -->
              <div class="gallery-card-body">
                <h3 class="gallery-card-title"><%= photoTitle %></h3>
                <p class="gallery-card-desc"><%= photoDesc %></p>
              </div>
            </a>
          </article>
        <% }); %>
      </div>
    </div>

  </div>
</section>
