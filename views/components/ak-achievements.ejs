<!-- ==========================================================================
     ARVIND KEJRIWAL AAP STYLE KEY ACHIEVEMENTS SECTION
     Section Header with Trophy Icon + 4-Column Card Grid with Metric Badges
     ========================================================================== -->
<%
  const pillarsList = (typeof whyChoose !== 'undefined' && whyChoose && whyChoose.pillars && whyChoose.pillars.length > 0)
    ? whyChoose.pillars
    : [
        {
          yearBadge: "100% निःशुल्क",
          title: "संवैधानिक आरक्षण व कानूनी पैरवी",
          description: "सर्वोच्च न्यायालय और संवैधानिक मंचों पर निषाद समाज के ऐतिहासिक आरक्षण अधिकारों की सशक्त और निरंतर कानूनी लड़ाई।",
          image: "/images/democratic-pledge-featured.jpg"
        },
        {
          yearBadge: "28+ राज्य",
          title: "अखंड राष्ट्रीय चेतना व जन-एकता",
          description: "150 से अधिक जनपदों में 50,000 से अधिक परिवारों को सीधे जोड़कर सामाजिक न्याय की मुख्यधारा में सशक्त भागीदारी।",
          image: "/images/democratic-pledge-varanasi.jpg"
        },
        {
          yearBadge: "शिक्षा क्रांति",
          title: "युवा मार्गदर्शन व छात्रवृत्ति नेटवर्क",
          description: "समाज के मेधावी छात्र-छात्राओं को उच्च शिक्षा, प्रतियोगी परीक्षाओं और तकनीकी प्रशिक्षण के लिए निःशुल्क सहायता।",
          image: "/images/democratic-pledge-patna.jpg"
        },
        {
          yearBadge: "जल-अधिकार",
          title: "परंपरागत आजीविका व जल-संसाधन सुरक्षा",
          description: "नदी तटों, मत्स्य पालन और जल संपदा पर पारंपरिक कामगारों के अधिकारों की सुरक्षा हेतु नीतिगत संघर्ष।",
          image: "/images/democratic-pledge-bhopal.jpg"
        }
      ];

  const fallbackImgs = [
    "/images/democratic-pledge-featured.jpg",
    "/images/democratic-pledge-varanasi.jpg",
    "/images/democratic-pledge-patna.jpg",
    "/images/democratic-pledge-bhopal.jpg"
  ];
%>

<section class="ak-section ak-bg-white" id="achievements">
  <div class="ak-container">

    <!-- Signature Section Header -->
    <div class="ak-section-header">
      <div class="ak-header-icon-box">
        <svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor">
          <path d="M19 5h-2V3H7v2H5c-1.1 0-2 .9-2 2v1c0 2.55 1.92 4.63 4.39 4.94.63 1.5 1.98 2.63 3.61 2.96V19H7v2h10v-2h-4v-3.1c1.63-.33 2.98-1.46 3.61-2.96C19.08 12.63 21 10.55 21 8V7c0-1.1-.9-2-2-2zM5 8V7h2v3.82C5.84 10.4 5 9.3 5 8zm14 0c0 1.3-.84 2.4-2 2.82V7h2v1z"/>
        </svg>
      </div>
      <h2 class="ak-header-title">
        मुख्य उपलब्धियां <span class="ak-highlight">Key Achievements</span>
      </h2>
    </div>

    <p class="ak-header-sub">
      समाज के निरंतर संघर्ष, समर्पित कार्यकर्ताओं और ऐतिहासिक संकल्प यात्रा के माध्यम से हासिल किए गए ऐतिहासिक मील के पत्थर।
    </p>

    <!-- 4-Column Card Grid -->
    <div class="ak-cards-grid ak-grid-4">
      <% pillarsList.forEach(function(item, idx) { %>
        <article class="ak-card">
          <div class="ak-card-img-wrap">
            <img 
              src="<%= item.image || fallbackImgs[idx % fallbackImgs.length] %>" 
              alt="<%= item.title %>" 
              loading="lazy" 
              onerror="this.src='/images/kalash-yatra-featured.jpg'"
            />
            <span class="ak-card-badge">
              <%= item.yearBadge || item.tag || ('उपलब्धि ' + (idx + 1)) %>
            </span>
          </div>

          <div class="ak-card-body">
            <span class="ak-card-meta">
              <span>★</span> Milestone Impact
            </span>
            <h3 class="ak-card-title"><%= item.title %></h3>
            <p class="ak-card-desc"><%= item.description %></p>
            <span class="ak-card-link-text">विस्तार से जानें →</span>
          </div>
        </article>
      <% }); %>
    </div>

  </div>
</section>
