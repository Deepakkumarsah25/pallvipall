<link rel="icon" type="image/png" href="/images/logo.png" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Devanagari:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
<link rel="stylesheet" href="/css/common/navbar.css" />

<header class="site-header">
  <nav class="navbar">
    <a href="/" class="brand" title="Pallavi Pal - आधिकारिक वेबसाइट" aria-label="Pallavi Pal official home">
      <img class="brand-logo" src="/images/pallavipal_logo.png" alt="पल्लवी पाल" />
      <span class="brand-name">Pallavi Pal</span>
    </a>

    <ul class="nav-links" id="navLinks">
      <li><a href="/" class="<%= typeof currentUrl !== 'undefined' && currentUrl === '/' ? 'active' : '' %>">Home</a></li>
      <li><a href="/about" class="<%= typeof currentUrl !== 'undefined' && currentUrl === '/about' ? 'active' : '' %>">About</a></li>
      <li><a href="/gallery" class="<%= typeof currentUrl !== 'undefined' && (currentUrl === '/gallery' || currentUrl === '/images') ? 'active' : '' %>">Gallery</a></li>
      <li><a href="/social" class="<%= typeof currentUrl !== 'undefined' && currentUrl === '/social' ? 'active' : '' %>">Social</a></li>
      <li><a href="/contact" class="<%= typeof currentUrl !== 'undefined' && currentUrl === '/contact' ? 'active' : '' %>">Contact</a></li>
    </ul>

    <button class="burger" id="burgerBtn" aria-label="Open menu" aria-expanded="false" type="button">
      <span></span>
      <span></span>
      <span></span>
    </button>
  </nav>
</header>

<div class="drawer-overlay" id="drawerOverlay"></div>

<script src="/js/common/navbar.js"></script>
