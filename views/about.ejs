<!DOCTYPE html>
<html lang="hi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title><%= typeof title !== 'undefined' ? title : 'जीवन परिचय एवं विजन | पल्लवी पाल' %></title>
  <link rel="icon" type="image/png" href="/images/logo.png" />
  <meta name="description" content="<%= typeof metaDescription !== 'undefined' ? metaDescription : 'पल्लवी पाल - जनसेवा, सामाजिक न्याय, महिला सशक्तिकरण और विकास को समर्पित जननेता का संपूर्ण जीवन परिचय एवं विचार' %>" />
  <link rel="canonical" href="https://pallavipal.com/about" />
  <meta property="og:title" content="<%= typeof title !== 'undefined' ? title : 'जीवन परिचय एवं विजन | पल्लवी पाल' %>" />
  <meta property="og:description" content="<%= typeof metaDescription !== 'undefined' ? metaDescription : 'पल्लवी पाल - जनसेवा, सामाजिक न्याय, महिला सशक्तिकरण और विकास को समर्पित जननेता का संपूर्ण जीवन परिचय एवं विचार' %>" />
  <meta property="og:url" content="https://pallavipal.com/about" />
  <meta property="og:type" content="website" />
  <meta property="og:image" content="https://pallavipal.com/images/logo.png" />

  <!-- Google Fonts for authentic Devanagari typography -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Devanagari:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

  <!-- Global & Common Styles -->
  <link rel="stylesheet" href="/css/index.css" />
  <link rel="stylesheet" href="/css/common/navbar.css" />

  <!-- Dedicated About Page CSS (Ultra-Compact & Responsive) -->
  <link rel="stylesheet" href="/css/about.css" />
</head>

<body class="about-page-body">

  <!-- Top Navigation Header -->
  <%- include("common/navbar") %>

  <!-- =====================================================================
       1. ULTRA-COMPACT HEADER (CLEAN & MINIMAL HEIGHT)
  ====================================================================== -->
  <header class="about-hero-compact">
    <div class="about-hero-compact-inner">
      <h1><%= about.meta && about.meta.pageTitle ? about.meta.pageTitle : 'पल्लवी पाल: जनसेवा, संघर्ष और विजन का संपूर्ण परिचय' %></h1>
      <p class="hero-tagline-text">
        <%= about.meta && about.meta.pageSubtitle ? about.meta.pageSubtitle : 'संवैधानिक अधिकार, सामाजिक न्याय, विकास और जनसेवा का पावन संकल्प' %>
      </p>
    </div>
  </header>

  <!-- =====================================================================
       2. STICKY 7-POINT QUICK NAVIGATION BAR (CLICK TO SCROLL)
  ====================================================================== -->
  <nav class="about-sticky-nav-wrapper" id="aboutStickyNav" aria-label="7 मुख्य बिंदु नेविगेशन">
    <div class="about-nav-container" id="aboutNavContainer">
      <a href="#objective" class="nav-pill-item active" id="navPill-1">
        <span class="pill-num">1</span>
        <span><%= about.objective && about.objective.navTitle ? about.objective.navTitle : 'अभियान का उद्देश्य' %></span>
      </a>

      <a href="#mission" class="nav-pill-item" id="navPill-2">
        <span class="pill-num">2</span>
        <span><%= about.mission && about.mission.navTitle ? about.mission.navTitle : 'मिशन' %></span>
      </a>

      <a href="#vision" class="nav-pill-item" id="navPill-3">
        <span class="pill-num">3</span>
        <span><%= about.vision && about.vision.navTitle ? about.vision.navTitle : 'Vision' %></span>
      </a>

      <a href="#background" class="nav-pill-item" id="navPill-4">
        <span class="pill-num">4</span>
        <span><%= about.background && about.background.navTitle ? about.background.navTitle : 'अभियान की पृष्ठभूमि' %></span>
      </a>

      <a href="#reservation" class="nav-pill-item" id="navPill-5">
        <span class="pill-num">5</span>
        <span><%= about.reservation && about.reservation.navTitle ? about.reservation.navTitle : 'नीतिगत पहल' %></span>
      </a>

      <a href="#activities" class="nav-pill-item" id="navPill-6">
        <span class="pill-num">6</span>
        <span><%= about.activities && about.activities.navTitle ? about.activities.navTitle : 'प्रमुख गतिविधियां' %></span>
      </a>

      <a href="#messages" class="nav-pill-item" id="navPill-7">
        <span class="pill-num">7</span>
        <span><%= about.messages && about.messages.navTitle ? about.messages.navTitle : 'महत्वपूर्ण संदेश' %></span>
      </a>
    </div>
  </nav>

  <!-- =====================================================================
       POINT 1: अभियान का उद्देश्य (OBJECTIVE)
  ====================================================================== -->
  <section class="about-section" id="objective">
    <div class="about-container">
      <div class="about-sec-header">
        <h2><%= about.objective.title %></h2>
        <p class="sec-desc"><%= about.objective.description %></p>
      </div>

      <% if (about.objective.points && about.objective.points.length > 0) { %>
        <div class="objective-grid">
          <% about.objective.points.forEach((pt, idx) => { %>
            <div class="obj-card">
              <div class="obj-icon-num"><%= idx + 1 %></div>
              <div class="obj-card-content">
                <h3><%= pt.title %></h3>
                <p><%= pt.desc %></p>
              </div>
            </div>
          <% }); %>
        </div>
      <% } %>
    </div>
  </section>

  <!-- =====================================================================
       POINT 2: मिशन (MISSION)
  ====================================================================== -->
  <section class="about-section" id="mission">
    <div class="about-container">
      <div class="about-sec-header">
        <h2><%= about.mission.title %></h2>
        <p class="sec-desc"><%= about.mission.description %></p>
      </div>

      <% if (about.mission.pillars && about.mission.pillars.length > 0) { %>
        <div class="mission-pillars-grid">
          <% about.mission.pillars.forEach((pil, idx) => { %>
            <div class="pillar-card">
              <div class="pillar-badge-num"><%= idx + 1 %></div>
              <h3><%= pil.title %></h3>
              <p><%= pil.desc %></p>
            </div>
          <% }); %>
        </div>
      <% } %>
    </div>
  </section>

  <!-- =====================================================================
       POINT 3: VISION (दृष्टिकोण)
  ====================================================================== -->
  <section class="about-section" id="vision">
    <div class="about-container">
      <div class="about-sec-header">
        <h2><%= about.vision.title %></h2>
        <p class="sec-desc"><%= about.vision.description %></p>
      </div>

      <div class="vision-layout-wrap">
        <div class="vision-goals-list">
          <% if (about.vision.visionPoints && about.vision.visionPoints.length > 0) { %>
            <% about.vision.visionPoints.forEach((vp) => { %>
              <div class="vision-goal-item">
                <div class="goal-check-icon">✓</div>
                <div>
                  <h4><%= vp.title %></h4>
                  <p><%= vp.desc %></p>
                </div>
              </div>
            <% }); %>
          <% } %>
        </div>

        <div class="vision-visual-card">
          <img src="<%= about.vision.image || '/images/kalash-yatra-featured.jpg' %>" alt="Vision" loading="lazy" />
        </div>
      </div>
    </div>
  </section>

  <!-- =====================================================================
       POINT 4: अभियान की पृष्ठभूमि (BACKGROUND & HISTORY)
  ====================================================================== -->
  <section class="about-section" id="background">
    <div class="about-container">
      <div class="about-sec-header">
        <h2><%= about.background.title %></h2>
        <p class="sec-desc"><%= about.background.description %></p>
      </div>

      <% if (about.background.timeline && about.background.timeline.length > 0) { %>
        <div class="timeline-track-wrap">
          <div class="timeline-grid">
            <% about.background.timeline.forEach((tm, idx) => { %>
              <div class="timeline-node">
                <span class="timeline-phase-tag"><%= tm.phase %></span>
                <h4><%= tm.title %></h4>
                <p><%= tm.desc %></p>
              </div>
            <% }); %>
          </div>
        </div>
      <% } %>
    </div>
  </section>

  <!-- =====================================================================
       POINT 5: आरक्षण संकल्प जानकारी (RESERVATION)
  ====================================================================== -->
  <section class="about-section" id="reservation">
    <div class="about-container">
      <div class="about-sec-header">
        <h2><%= about.reservation.title %></h2>
        <p class="sec-desc"><%= about.reservation.description %></p>
      </div>

      <% if (about.reservation.keyDemands && about.reservation.keyDemands.length > 0) { %>
        <div class="demands-grid">
          <% about.reservation.keyDemands.forEach((dem) => { %>
            <div class="demand-card">
              <div class="demand-top-bar">
                <span class="demand-tag-pill"><%= dem.tag || 'संवैधानिक मांग' %></span>
              </div>
              <h4><%= dem.title %></h4>
              <p><%= dem.desc %></p>
            </div>
          <% }); %>
        </div>
      <% } %>
    </div>
  </section>

  <!-- =====================================================================
       POINT 6: प्रमुख गतिविधियां (ACTIVITIES)
  ====================================================================== -->
  <section class="about-section" id="activities">
    <div class="about-container">
      <div class="about-sec-header">
        <h2><%= about.activities.title %></h2>
        <p class="sec-desc"><%= about.activities.description %></p>
      </div>

      <!-- Activities Showcase: Photo Left, Details Right in Laptop / Underneath in Phone -->
      <div class="activities-showcase-wrap">
        <div class="act-showcase-visual">
          <img src="<%= about.activities.image || '/images/democratic-pledge-featured.jpg' %>" alt="<%= about.activities.detailTitle || about.activities.title %>" loading="lazy" />
          <div class="act-showcase-badge">
            <span class="badge-dot"></span> जमीनी अभियान झलक
          </div>
        </div>

        <div class="act-showcase-detail">
          <h3><%= about.activities.detailTitle || 'जमीनी गतिविधियां एवं जनसंपर्क विस्तार' %></h3>
          <p class="act-detail-narrative"><%= about.activities.detailDescription || 'प्रत्येक गांव, पंचायत और ब्लॉक स्तर पर चौपालों और जनसंवाद कार्यक्रमों का निरंतर आयोजन किया जा रहा है, जिससे आम जनता तक अधिकार और विकास का संदेश पहुंचे।' %></p>

          <% 
            const actShowcasePoints = (about.activities.detailPoints && about.activities.detailPoints.length > 0) 
              ? about.activities.detailPoints 
              : [
                  { title: "गांव-गांव चौपाल व जनसंवाद", desc: "बुजुर्गों, युवाओं और महिलाओं के साथ बैठकर स्थानीय समस्याओं व विकास योजनाओं पर संवाद।" },
                  { title: "जन-सहयोग एवं सदस्यता", desc: "लाखों परिवारों को सीधे जोड़कर संगठित जन-आंदोलन का निर्माण।" },
                  { title: "विधिक व सामाजिक मार्गदर्शन", desc: "छात्रवृत्ति, किसान योजनाएं व सरकारी योजनाओं के लाभ हेतु युवाओं और जरूरतमंदों को मार्गदर्शन।" }
                ];
          %>
          <div class="act-detail-points">
            <% actShowcasePoints.forEach((pt) => { %>
              <div class="act-point-item">
                <div class="act-point-check">✓</div>
                <div class="act-point-text">
                  <h4><%= pt.title %></h4>
                  <p><%= pt.desc %></p>
                </div>
              </div>
            <% }); %>
          </div>
        </div>
      </div>

      <% if (about.activities.activityList && about.activities.activityList.length > 0) { %>
        <div class="activities-grid">
          <% about.activities.activityList.forEach((act) => { %>
            <div class="activity-card">
              <div class="activity-img-wrap">
                <img src="<%= act.image || '/images/democratic-pledge-varanasi.jpg' %>" alt="<%= act.name %>" loading="lazy" />
                <span class="activity-tag-overlay"><%= act.tag %></span>
              </div>
              <div class="activity-content">
                <h3><%= act.name %></h3>
                <p><%= act.desc %></p>
              </div>
            </div>
          <% }); %>
        </div>
      <% } %>
    </div>
  </section>

  <!-- =====================================================================
       POINT 7: महत्वपूर्ण संदेश (IMPORTANT MESSAGES)
  ====================================================================== -->
  <section class="about-section" id="messages">
    <div class="about-container">
      <div class="about-sec-header">
        <h2><%= about.messages.title %></h2>
        <p class="sec-desc"><%= about.messages.description %></p>
      </div>

      <% if (about.messages.messagesList && about.messages.messagesList.length > 0) { %>
        <div class="messages-grid">
          <% about.messages.messagesList.forEach((msg) => { %>
            <div class="message-card">
              <div class="msg-quote-mark">“</div>
              <p class="msg-text"><%= msg.message %></p>
              <div class="msg-author-row">
                <img src="<%= msg.photo || '/images/democratic-pledge-patna.jpg' %>" alt="<%= msg.senderName %>" class="msg-avatar" loading="lazy" />
                <div class="msg-author-info">
                  <h4><%= msg.senderName %></h4>
                  <span class="role"><%= msg.role %></span>
                  <span class="desig"><%= msg.designation %></span>
                </div>
              </div>
            </div>
          <% }); %>
        </div>
      <% } %>
    </div>
  </section>

  <!-- =====================================================================
       FLOATING BACK TO TOP BUTTON
  ====================================================================== -->
  <button class="back-to-top-btn" id="backToTopBtn" aria-label="पेज के शीर्ष पर जाएं">
    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="18 15 12 9 6 15"/></svg>
  </button>

  <!-- Common Footer -->
  <%- include("common/footer") %>

  <!-- Dedicated About Page JS -->
  <script src="/js/about.js"></script>

</body>
</html>
