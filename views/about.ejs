<!DOCTYPE html>
<html lang="hi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= typeof title !== 'undefined' ? title : 'पल्लवी पाल | नेता, समाजवादी पार्टी' %></title>
  <meta name="description" content="<%= typeof metaDescription !== 'undefined' ? metaDescription : 'पल्लवी पाल - समाजवादी पार्टी नेत्री, सामाजिक न्याय एवं जनसेवा के प्रति समर्पित राजनीतिक नेतृत्व।' %>" />

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Noto+Sans+Devanagari:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

  <!-- Common Stylesheets -->
  <link rel="stylesheet" href="/css/index.css" />
  <link rel="stylesheet" href="/css/common/navbar.css" />
  <link rel="stylesheet" href="/css/common/footer.css" />

  <!-- About Leader Stylesheet -->
  <link rel="stylesheet" href="/css/about.css" />
</head>

<body class="about-page-body">

  <%- include("common/navbar") %>

  <!-- HERO / PROFILE SECTION (CLEAN, NO REDUNDANT BOXES) -->
  <header class="profile-hero-section" id="profile">
    <div class="sp-flag-stripe" aria-hidden="true">
      <span class="sp-stripe-red"></span>
      <span class="sp-stripe-green"></span>
    </div>

    <div class="leader-hero-container">
      <div class="leader-hero-grid">
        
        <!-- Leader Photo Column -->
        <div class="leader-photo-column">
          <div class="leader-avatar-frame">
            <img 
              src="<%= (about && about.profile && about.profile.photo) ? about.profile.photo : '/images/about/pallavi-pal.svg' %>" 
              alt="<%= (about && about.profile && about.profile.name) ? about.profile.name : 'पल्लवी पाल' %>" 
              class="leader-avatar-img"
              id="leaderPhoto"
              loading="eager"
            />
            <div class="sp-badge-chip">
              <span class="sp-dot-red"></span>
              <span class="sp-badge-text"><%= (about && about.profile && about.profile.party) ? about.profile.party : 'समाजवादी पार्टी' %></span>
            </div>
          </div>
        </div>

        <!-- Leader Content Column -->
        <div class="leader-content-column">
          <div class="leader-title-meta">
            <span class="leader-constituency-pill">
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z"/><circle cx="12" cy="9" r="2.5"/></svg>
              <%= (about && about.profile && about.profile.constituency) ? about.profile.constituency : 'उत्तर प्रदेश (Uttar Pradesh)' %>
            </span>

            <h1 class="leader-main-name">
              <%= (about && about.profile && about.profile.name) ? about.profile.name : 'पल्लवी पाल' %>
            </h1>

            <p class="leader-official-designation">
              <%= (about && about.profile && about.profile.designation) ? about.profile.designation : 'नेता, समाजवादी पार्टी' %>
            </p>
          </div>

          <!-- CURRENT POSITION (SEAMLESSLY INTEGRATED INTO HERO FLOW) -->
          <% if (about && about.currentPosition && (about.currentPosition.title || about.currentPosition.role || about.currentPosition.description)) { %>
            <div class="hero-current-position-flow">
              <div class="hero-pos-top-row">
                <span class="hero-pos-badge">वर्तमान दायित्व (Current Position)</span>
                <% if (about.currentPosition.location) { %>
                  <span class="hero-pos-loc">📍 <%= about.currentPosition.location %></span>
                <% } %>
              </div>

              <h2 class="hero-pos-title">
                <%= about.currentPosition.title || 'वरिष्ठ नेत्री, समाजवादी पार्टी' %>
              </h2>

              <% if (about.currentPosition.role) { %>
                <p class="hero-pos-org">
                  <strong>दल / संगठन:</strong> <%= about.currentPosition.role %>
                </p>
              <% } %>

              <% if (about.currentPosition.description) { %>
                <p class="hero-pos-description">
                  <%= about.currentPosition.description %>
                </p>
              <% } %>
            </div>
          <% } %>

        </div>

      </div>
    </div>
  </header>

  <main class="about-main-wrapper">

    <!-- 1. BIOGRAPHY / ABOUT (जीवन परिचय एवं विचारधारा) - PROSE PARAGRAPHS -->
    <section class="about-section" id="biography">
      <div class="container-standard">
        <div class="section-title-wrap">
          <h2 class="section-heading">
            <%= (about && about.biography && about.biography.heading) ? about.biography.heading : 'जीवन परिचय एवं विचारधारा' %>
          </h2>
          <div class="section-accent-line"></div>
        </div>

        <div class="biography-editorial-flow">
          <% if (about && about.biography && about.biography.summary) { %>
            <p class="biography-lead-paragraph">
              <%= about.biography.summary %>
            </p>
          <% } %>

          <% if (about && about.biography && about.biography.paragraphs && about.biography.paragraphs.length > 0) { %>
            <div class="biography-paragraphs-stream">
              <% about.biography.paragraphs.forEach((p) => { %>
                <% if (p && p.trim()) { %>
                  <p class="editorial-narrative-paragraph"><%= p %></p>
                <% } %>
              <% }); %>
            </div>
          <% } %>

          <!-- Core Values / Ideological Principles (Tasteful Inline Badge Row) -->
          <% if (about && about.biography && about.biography.coreValues && about.biography.coreValues.length > 0) { %>
            <div class="biography-values-flow">
              <h3 class="values-flow-heading">मूल सिद्धांत एवं जनसरोकार</h3>
              <div class="values-flow-pills">
                <% about.biography.coreValues.forEach((val) => { %>
                  <span class="value-flow-pill">
                    <span class="value-flow-dot"></span>
                    <%= val %>
                  </span>
                <% }); %>
              </div>
            </div>
          <% } %>
        </div>
      </div>
    </section>

    <!-- 2. EDUCATION (शिक्षा) - RESUME / NARRATIVE LIST FORMAT -->
    <section class="about-section bg-subtle" id="education">
      <div class="container-standard">
        <div class="section-title-wrap">
          <h2 class="section-heading">शिक्षा (Education)</h2>
          <div class="section-accent-line"></div>
        </div>

        <% if (about && about.education && about.education.length > 0) { %>
          <div class="education-editorial-list">
            <% about.education.sort((a, b) => (a.order || 0) - (b.order || 0)).forEach((edu) => { %>
              <article class="education-row-item">
                <div class="edu-item-header">
                  <h3 class="edu-item-degree"><%= edu.degree %></h3>
                  <% if (edu.year) { %>
                    <span class="edu-item-year"><%= edu.year %></span>
                  <% } %>
                </div>
                <% if (edu.institution) { %>
                  <p class="edu-item-institution">🏛️ <%= edu.institution %></p>
                <% } %>
                <% if (edu.details) { %>
                  <p class="edu-item-details-paragraph"><%= edu.details %></p>
                <% } %>
              </article>
            <% }); %>
          </div>
        <% } else { %>
          <p class="empty-state-notice">शैक्षणिक विवरण शीघ्र ही अपडेट किया जाएगा।</p>
        <% } %>
      </div>
    </section>

    <!-- 3. POLITICAL CAREER (राजनीतिक यात्रा) - MILESTONE TIMELINE PARAGRAPHS -->
    <section class="about-section" id="career">
      <div class="container-standard">
        <div class="section-title-wrap">
          <h2 class="section-heading">राजनीतिक सफर एवं महत्वपूर्ण पड़ाव</h2>
          <div class="section-accent-line"></div>
        </div>

        <% if (about && about.politicalCareer && about.politicalCareer.length > 0) { %>
          <div class="career-editorial-timeline">
            <% about.politicalCareer.sort((a, b) => (a.order || 0) - (b.order || 0)).forEach((milestone, idx) => { %>
              <article class="career-milestone-entry">
                <div class="milestone-indicator-side">
                  <span class="milestone-step-number"><%= idx + 1 %></span>
                  <div class="milestone-connector-line"></div>
                </div>
                <div class="milestone-details-body">
                  <div class="milestone-headline-wrap">
                    <h3 class="milestone-title"><%= milestone.title %></h3>
                    <% if (milestone.period) { %>
                      <span class="milestone-period-pill"><%= milestone.period %></span>
                    <% } %>
                  </div>
                  <% if (milestone.description) { %>
                    <p class="milestone-narrative-paragraph"><%= milestone.description %></p>
                  <% } %>
                </div>
              </article>
            <% }); %>
          </div>
        <% } else { %>
          <p class="empty-state-notice">राजनीतिक यात्रा विवरण शीघ्र ही उपलब्ध होगा।</p>
        <% } %>
      </div>
    </section>

    <!-- 4. SAMAJWADI PARTY POSTS (समाजवादी पार्टी दायित्व) - ORGANIZATIONAL SUMMARY LIST -->
    <section class="about-section bg-subtle" id="party-posts">
      <div class="container-standard">
        <div class="section-title-wrap">
          <h2 class="section-heading">समाजवादी पार्टी में संगठनात्मक भूमिका</h2>
          <div class="section-accent-line"></div>
        </div>

        <% if (about && about.partyPosts && about.partyPosts.length > 0) { %>
          <div class="party-posts-editorial-stream">
            <% about.partyPosts.sort((a, b) => (a.order || 0) - (b.order || 0)).forEach((post) => { %>
              <article class="party-post-entry">
                <div class="party-post-header">
                  <div class="party-post-title-group">
                    <h3 class="party-post-title"><%= post.postTitle %></h3>
                    <% if (post.wing) { %>
                      <span class="party-wing-tag"><%= post.wing %></span>
                    <% } %>
                  </div>
                  <% if (post.period) { %>
                    <span class="party-post-period"><%= post.period %></span>
                  <% } %>
                </div>
                <% if (post.description) { %>
                  <p class="party-post-paragraph"><%= post.description %></p>
                <% } %>
              </article>
            <% }); %>
          </div>
        <% } else { %>
          <p class="empty-state-notice">पार्टी दायित्व विवरण शीघ्र ही अपडेट किया जाएगा।</p>
        <% } %>
      </div>
    </section>

    <!-- 5. ACHIEVEMENTS (उपलब्धियां) - DISTINGUISHED MILESTONES PROSE -->
    <section class="about-section" id="achievements">
      <div class="container-standard">
        <div class="section-title-wrap">
          <h2 class="section-heading">सफलताएं एवं जनहित कार्य (Achievements)</h2>
          <div class="section-accent-line"></div>
        </div>

        <% if (about && about.achievements && about.achievements.length > 0) { %>
          <div class="achievements-editorial-stream">
            <% about.achievements.sort((a, b) => (a.order || 0) - (b.order || 0)).forEach((ach) => { %>
              <article class="achievement-entry-item">
                <div class="achievement-header-row">
                  <div class="achievement-title-area">
                    <span class="achievement-star-icon">★</span>
                    <h3 class="achievement-title"><%= ach.title %></h3>
                  </div>
                  <div class="achievement-meta-badges">
                    <% if (ach.category) { %>
                      <span class="achievement-category-tag"><%= ach.category %></span>
                    <% } %>
                    <% if (ach.year) { %>
                      <span class="achievement-year-tag"><%= ach.year %></span>
                    <% } %>
                  </div>
                </div>
                <% if (ach.description) { %>
                  <p class="achievement-paragraph"><%= ach.description %></p>
                <% } %>
              </article>
            <% }); %>
          </div>
        <% } else { %>
          <p class="empty-state-notice">उपलब्धियों का विवरण शीघ्र ही उपलब्ध होगा।</p>
        <% } %>
      </div>
    </section>

    <!-- 6. SOCIAL WORK (सामाजिक कार्य) - NARRATIVE STORIES & PUBLIC WELFARE PROSE -->
    <section class="about-section bg-subtle" id="social-work">
      <div class="container-standard">
        <div class="section-title-wrap">
          <h2 class="section-heading">जनसेवा एवं समाज कल्याण (Social Work)</h2>
          <div class="section-accent-line"></div>
        </div>

        <% if (about && about.socialWork && about.socialWork.length > 0) { %>
          <div class="social-work-stories-flow">
            <% about.socialWork.sort((a, b) => (a.order || 0) - (b.order || 0)).forEach((work) => { %>
              <article class="social-work-story-item">
                <div class="social-work-story-header">
                  <h3 class="social-work-story-title"><%= work.title %></h3>
                  <% if (work.focusArea) { %>
                    <span class="social-work-focus-pill"><%= work.focusArea %></span>
                  <% } %>
                </div>
                <% if (work.description) { %>
                  <p class="social-work-story-paragraph"><%= work.description %></p>
                <% } %>
              </article>
            <% }); %>
          </div>
        <% } else { %>
          <p class="empty-state-notice">सामाजिक कार्यों का विवरण शीघ्र ही उपलब्ध होगा।</p>
        <% } %>
      </div>
    </section>

    <!-- 7. OFFICIAL SOCIAL MEDIA LINKS (सोशल मीडिया संपर्क) -->
    <section class="about-section" id="connect">
      <div class="container-standard">
        <div class="section-title-wrap">
          <h2 class="section-heading">सोशल मीडिया एवं संपर्क सूत्र</h2>
          <div class="section-accent-line"></div>
          <p class="section-subtitle-text">पल्लवी पाल जी से सीधे जुड़ें एवं समाजवादी पार्टी के विचारों व गतिविधियों से अपडेट रहें:</p>
        </div>

        <% if (about && about.socialLinks && about.socialLinks.length > 0) { %>
          <div class="official-social-grid">
            <% about.socialLinks.sort((a, b) => (a.order || 0) - (b.order || 0)).forEach((social) => { %>
              <a href="<%= social.url %>" target="_blank" rel="noopener noreferrer" class="social-connect-card">
                <div class="social-connect-left">
                  <div class="social-platform-badge">
                    <span><%= social.platform ? social.platform.charAt(0).toUpperCase() : '🔗' %></span>
                  </div>
                  <div class="social-connect-text">
                    <h3 class="social-platform-name"><%= social.platform %></h3>
                    <p class="social-handle-text"><%= social.handle || 'Official Profile' %></p>
                  </div>
                </div>
                <div class="social-connect-arrow">
                  <span>फ़ॉलो करें ↗</span>
                </div>
              </a>
            <% }); %>
          </div>
        <% } else { %>
          <p class="empty-state-notice">सोशल मीडिया लिंक शीघ्र ही उपलब्ध होंगे।</p>
        <% } %>
      </div>
    </section>

  </main>

  <%- include("common/footer") %>

</body>
</html>